---
import { totalConferencias, enPalabra } from '../scripts/programa.js';
import { asset } from '../scripts/paths.js';

/*
  Sección de introducción al congreso.

  El video es un archivo LOCAL servido desde /public, no un embed. Es un MP4
  de 1920×1080 y 26 MB, así que la regla que gobierna este bloque es que
  nada de eso se descargue hasta que hace falta:

  - `preload="none"` — sin esto el navegador se trae al menos las cabeceras y,
    según implementación, el primer tramo del archivo. A este tamaño eso es
    inaceptable en datos móviles, que es como llega la mayor parte del tráfico
    de este sitio (ver «Revisión de móvil» en la bitácora).
  - `poster` — un WebP de 37 KB es TODO lo que pesa la sección hasta que se
    reproduce algo. Además es lo que reserva el fotograma: sin él, la caja
    quedaría vacía.
  - El `aspect-ratio: 16/9` del contenedor ya evitaba el CLS con el
    placeholder y lo sigue haciendo con el `<video>`; el poster comparte esa
    proporción exacta (960×540), así que no hay reencuadre ni salto.

  AUTOPLAY SILENCIOSO — SIN el atributo `autoplay` del marcado. Se probó a
  propósito (`<video autoplay muted loop preload="none">` fuera de la vista):
  el navegador pide el archivo igual, de inmediato, sin esperar a que entre en
  el viewport. `autoplay` le gana a `preload="none"`, así que aquí el disparo
  de la reproducción es manual, con un IntersectionObserver en el `<script>` de
  abajo, y es su `.play()` el que arranca la descarga — no antes. `muted` y
  `loop` sí son atributos estáticos: se probó también y, solos, sin
  `autoplay`, no piden nada (medido: 0 peticiones a `promo.mp4` sin ese play).
*/

/*
  El lead ABRE con el número, así que va en letra y con mayúscula inicial. Se
  compone aquí y no en la plantilla para no meter un `replace` con expresión
  regular en medio del texto, que es donde peor se lee.
*/
const cuantas = enPalabra(totalConferencias());
const Cuantas = cuantas.charAt(0).toUpperCase() + cuantas.slice(1);
---

<section class="intro" id="congreso">
  <div class="intro__inner">
    <header class="intro__head">
      <p class="intro__eyebrow" data-anim>El congreso</p>
      <h2 class="intro__title" data-anim>Un día, toda la operación avícola</h2>
      <p class="intro__lead" data-anim>
        {Cuantas} conferencias, un panel de expertos y un show de medio tiempo conectan
        los tres frentes que deciden el resultado de una granja: productividad,
        sanidad preventiva y tecnología aplicada. Entre sesiones, coffee break y
        área comercial para ver equipo y hablar de frente con proveedores.
      </p>
    </header>

    <div class="intro__player" data-anim>
      <video
        class="intro__media"
        controls
        preload="none"
        playsinline
        muted
        loop
        poster={asset('video/poster.webp')}
        width="1920"
        height="1080"
      >
        <source src={asset('video/promo.mp4')} type="video/mp4" />
        Tu navegador no puede reproducir este video.
      </video>

      {/*
        Botón de sonido. Gateado tras [data-js] en el CSS: sin autoplay no hace
        falta —el video sigue con controles nativos que ya traen volumen— y sin
        JS no tiene con qué reaccionar al clic.

        data-muted arranca PRESENTE a propósito: coincide con el estado real en
        el caso común (recién pintado, el video parte muted) y con
        prefers-reduced-motion —donde tampoco cambia, el atributo `muted` del
        marcado sigue muted hasta que alguien le dé play—. El script solo
        confirma el estado real al cargar, no lo adivina.

        data-pulso también arranca PRESENTE: el pulso de aviso solo dura los
        primeros 3 s (lo retira el <script> de abajo) y solo se ve mientras el
        botón también lleva data-muted (ver el selector combinado en el
        <style>), así que si el visitante ya desmuteó el video —a mano o por
        la primera interacción— el pulso no llega a dibujarse.
      */}
      <button
        type="button"
        class="intro__sonido"
        data-sonido
        data-muted
        data-pulso
        aria-label="Activar sonido"
      >
        <svg
          class="intro__sonido-on"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M4 9.5v5h3.2l4.8 3.6V5.9L7.2 9.5H4Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
          <path
            d="M15.8 9.2a3.6 3.6 0 0 1 0 5.6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <path
            d="M18.1 6.8a7 7 0 0 1 0 10.4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
        <svg
          class="intro__sonido-off"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M4 9.5v5h3.2l4.8 3.6V5.9L7.2 9.5H4Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
          <path
            d="M15.5 9.5l5 5M20.5 9.5l-5 5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
        {/* Visible SOLO en muted, junto al icono tachado — la regla del
            encargo es "icono + texto" en un estado y "icono solo" en el
            otro, así que el texto va aparte del aria-label. */}
        <span class="intro__sonido-texto" aria-hidden="true">Activar sonido</span>
      </button>
    </div>
  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('.intro');
  const video = document.querySelector<HTMLVideoElement>('.intro__media');
  const botonSonido = document.querySelector<HTMLButtonElement>('[data-sonido]');

  // ---------------------------------------------------------------------
  // Botón de sonido. Esencial, sin dependencia de la capa de movimiento:
  // silenciar o activar el audio tiene que funcionar aunque GSAP no llegue.
  // ---------------------------------------------------------------------
  function actualizarBotonSonido(): void {
    if (!botonSonido || !video) return;
    botonSonido.toggleAttribute('data-muted', video.muted);
    botonSonido.setAttribute(
      'aria-label',
      video.muted ? 'Activar sonido' : 'Silenciar el video'
    );
  }

  if (botonSonido && video) {
    botonSonido.addEventListener('click', () => {
      video.muted = !video.muted;
      actualizarBotonSonido();
    });
    // Confirma el estado real al cargar: no se asume, se lee del propio video.
    actualizarBotonSonido();

    /*
      El pulso solo llama la atención 3 s y se detiene solo. No hace falta
      guardar prefers-reduced-motion aquí: el corte global de global.css ya
      fuerza animation-duration a 0.01ms y animation-iteration-count a 1 en
      *, así que la animación de abajo queda anulada sin escribir un segundo
      guardián — solo las animaciones IMPERATIVAS (GSAP) necesitan consultarlo
      a mano, según la convención 5.
    */
    window.setTimeout(() => botonSonido.removeAttribute('data-pulso'), 3000);
  }

  // ---------------------------------------------------------------------
  // Audio a la primera interacción del visitante con la página.
  //
  // Los navegadores bloquean el autoplay CON sonido, pero lo permiten en
  // cuanto hay un gesto real del usuario. En vez de esperar a que alguien
  // pulse el botón de sonido, un solo listener en `document` — click,
  // touchstart, scroll o keydown, el que llegue primero — desmutea el video
  // en cuanto se dispara. Si para entonces el video ya está reproduciéndose
  // (autoplay silencioso, más abajo), sigue sin cortes pero con audio.
  //
  // "Falla en silencio" a propósito: `video.muted = false` es una asignación
  // de propiedad, no una promesa — no hay nada que rechazar. Si el navegador
  // decide no permitir el audio (o directamente pausa el video porque el
  // gesto no cuenta como activación real, que es el caso típico de `scroll`
  // fuera de Chrome), el video se queda como estaba y el botón manual sigue
  // siendo el respaldo.
  // ---------------------------------------------------------------------
  if (video) {
    const gestos = ['click', 'touchstart', 'scroll', 'keydown'] as const;
    const activarAudio = () => {
      // Se quitan los CUATRO de una vez: `{ once: true }` solo autoelimina el
      // que disparó, y los otros tres seguirían escuchando de por vida.
      for (const gesto of gestos) document.removeEventListener(gesto, activarAudio);
      try {
        video.muted = false;
        actualizarBotonSonido();
      } catch {
        /* Sin soporte o rechazado: el botón manual sigue ahí. */
      }
    };
    for (const gesto of gestos) {
      document.addEventListener(gesto, activarAudio, { once: true, passive: true });
    }
  }

  // ---------------------------------------------------------------------
  // Autoplay silencioso al entrar en viewport (ver el comentario grande del
  // frontmatter: NO es el atributo `autoplay`, es este `.play()` manual).
  // ---------------------------------------------------------------------
  const prefiereMenosMovimiento = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (video && !prefiereMenosMovimiento) {
    const observadorVideo = new IntersectionObserver(
      (entradas, obs) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          /*
            Fuerza muted=true justo antes del play(), pase lo que pase antes.

            Probado y era necesario: si el gesto de la sección anterior ya
            desmuteó el video ANTES de que este observer disparara —el caso
            típico es "solo scroll", sin clic ni tecla—, un autoplay que
            arranca ya sin silenciar es autoplay CON SONIDO sin un gesto
            fuerte real detrás, y el navegador lo bloquea entero: el video se
            queda parado en el póster, sin cargar nada. Es PEOR que el
            comportamiento de antes de esta tarea, que sí reproducía
            silenciado.

            Por eso el autoplay SIEMPRE arranca muted —eso nunca lo bloquea
            nadie— y el intento de sonido, si el visitante ya lo había pedido,
            va DESPUÉS, cuando play() ya resolvió.
          */
          const sonidoQuerido = !video.muted;
          video.muted = true;
          video
            .play()
            .then(() => {
              if (sonidoQuerido) {
                video.muted = false;
                actualizarBotonSonido();
              }
            })
            .catch(() => {
              /*
                Alguna política de autoplay lo bloqueó pese a `muted`. El video
                se queda en el póster, listo para el play manual con los
                controles nativos — nunca es un error visible.
              */
            });
          obs.disconnect();
          return;
        }
      },
      { threshold: 0.5 }
    );
    observadorVideo.observe(video);
  }
  // Con prefers-reduced-motion no se registra observer: el video se queda
  // quieto en el póster hasta que alguien pulse play a mano.

  // Import dinámico, igual que en Nav y Hero: la capa de movimiento es mejora
  // progresiva y no debe poder tumbar nada esencial.
  import('../scripts/animations.js')
    .then(({ initMotion }) => {
      const { gsap, reduced } = initMotion();
      if (reduced || !gsap || !seccion) return;

      const elementos = seccion.querySelectorAll<HTMLElement>('[data-anim]');

      gsap.fromTo(
        elementos,
        { opacity: 0, y: 32 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: seccion,
            start: 'top 78%',
            once: true,
          },
        }
      );
    })
    .catch(() => {
      /* Sin capa de movimiento: la sección ya está en su estado final. */
    });
</script>

<style>
  .intro {
    padding-block: var(--space-3xl);
  }

  .intro__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .intro__head {
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-block-end: var(--space-2xl);
    text-align: center;
  }

  .intro__eyebrow {
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .intro__title {
    margin-block-start: var(--space-sm);
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .intro__lead {
    margin-block-start: var(--space-lg);
    color: var(--text-muted);
  }

  /* Reproductor ------------------------------------------------------------ */
  .intro__player {
    position: relative;
    max-width: var(--media-max);
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  /*
    `width: 100%` + `height: auto` para que los atributos width/height del
    marcado sirvan de proporción intrínseca y no de tamaño fijo: el navegador
    reserva la caja antes de tener el poster y el video nunca desborda su
    contenedor. El `aspect-ratio` explícito lo sostiene igualmente si el
    poster fallara.

    `max-width: 100%` no es redundante con `width: 100%`: un `<video>` con
    atributo `width="1920"` toma ese valor como base intrínseca y, en el
    contenedor angosto de móvil, sin el tope llegaría a desbordar.
  */
  .intro__media {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background-color: var(--surface);
    /* El poster es 16/9 igual que la caja: `cover` no recorta nada, solo
       blinda el caso de que algún día se cambie por uno de otra proporción. */
    object-fit: cover;
  }

  /*
    Botón de sonido. Oculto sin JS —igual que .barra en BarraCompra.astro—:
    sin autoplay el video ya trae volumen en sus controles nativos, así que un
    botón inerte aquí sería puro ruido visual.

    Esquina INFERIOR derecha, no superior: el encargo lo pide ahí para que se
    note de inmediato sobre el video, que es justo donde antes vivía discreto
    arriba. Se deja `--space-md` de margen a los dos bordes —más que el
    `--space-sm` de antes— para no montarse encima de los controles nativos,
    que Chrome dibuja pegados al borde inferior del `<video>`.
  */
  .intro__sonido {
    display: none;
  }

  :global([data-js]) .intro__sonido {
    position: absolute;
    /*
      El offset NO es --space-md a secas: medido en captura con los
      controles nativos forzados (:hover), a --space-md el botón caía
      encima del icono nativo de pantalla completa. Los controles de Chrome
      miden ~48px de alto pegados al borde inferior del <video>, así que se
      suma ese alto al margen para dejarlos libres del todo.
    */
    inset-block-end: calc(var(--space-md) + 48px);
    inset-inline-end: var(--space-md);
    z-index: 1;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    /* 52×52 reales: por encima del mínimo de 44 de .barra__cta, a propósito
       más prominente — es el pedido del encargo, no el mínimo de toque. */
    min-inline-size: 52px;
    min-block-size: 52px;
    padding-inline: var(--space-sm);

    border-radius: var(--radius-pill);
    /* Fallback sin blur: sólido y legible, igual criterio que .nav. */
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
    transition: background-color var(--t-base) var(--ease-out);
  }

  /*
    Semitranslúcido SOLO donde el navegador soporta blur de verdad, mismo
    doble @supports que la nav (convención ya escrita en BarraCompra.astro):
    color-mix() con var() dentro no se descarta al parsear en un navegador sin
    soporte, se invalida al COMPUTAR, y el fondo caería a transparent en vez
    del --bg opaco de arriba.

    72%, no el 55% que llevaba el botón chico: sobre un fotograma claro del
    video (el póster es cielo y casetas blancas) un fondo más traslúcido se
    leía apagado. Con esto se lee igual de bien sobre cualquier fotograma.
  */
  @supports (backdrop-filter: blur(1px)) and
    (background-color: color-mix(in srgb, red 50%, transparent)) {
    :global([data-js]) .intro__sonido {
      background-color: color-mix(in srgb, var(--bg) 72%, transparent);
      backdrop-filter: blur(var(--nav-blur));
    }
  }

  :global([data-js]) .intro__sonido:hover {
    background-color: var(--bg);
  }

  @supports (backdrop-filter: blur(1px)) and
    (background-color: color-mix(in srgb, red 50%, transparent)) {
    :global([data-js]) .intro__sonido:hover {
      background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    }
  }

  /* Un icono a la vez: cuál se ve depende de si el botón lleva data-muted. */
  .intro__sonido-on {
    display: none;
  }

  .intro__sonido:not([data-muted]) .intro__sonido-on {
    display: block;
  }

  .intro__sonido[data-muted] .intro__sonido-off {
    display: block;
  }

  .intro__sonido:not([data-muted]) .intro__sonido-off {
    display: none;
  }

  /*
    El texto "Activar sonido" SOLO en muted. Activado, el botón se queda en
    icono solo — es la forma que pide el encargo, y de paso encoge la píldora
    a un círculo otra vez (el ancho ya no lo empuja ningún texto).
  */
  .intro__sonido-texto {
    display: none;
  }

  .intro__sonido[data-muted] .intro__sonido-texto {
    display: inline;
  }

  /*
    Pulso de aviso, 3 s y se detiene solo (lo retira el <script>). El
    selector exige data-muted A LA VEZ que data-pulso: si el visitante ya
    desmuteó el video —a mano o por la primera interacción— antes de que
    pasen los 3 s, el pulso deja de dibujarse en el acto, no sigue llamando
    la atención sobre algo que ya pasó.

    Sin guardián local de prefers-reduced-motion: el corte global de
    global.css ya fuerza animation-duration a 0.01ms y
    animation-iteration-count a 1 en *, así que aquí no hace falta repetirlo
    (convención 5: solo las animaciones IMPERATIVAS, como GSAP, necesitan
    consultarlo a mano).
  */
  @keyframes intro-sonido-pulso {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
    }
    50% {
      box-shadow: 0 0 0 10px transparent;
    }
  }

  :global([data-js]) .intro__sonido[data-muted][data-pulso] {
    animation: intro-sonido-pulso 1.5s ease-in-out 2;
  }
</style>
