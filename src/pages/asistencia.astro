---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import '../styles/asistencia.css';

const rutaAdmin = `${import.meta.env.BASE_URL}admin/`;
---

<Base title={`Control de asistencia — ${site.nombre}`} noindex>
  <main class="asistencia" data-auth="cargando">
    <noscript>
      <p class="asistencia__noscript">El control de asistencia necesita JavaScript para funcionar.</p>
    </noscript>

    <section class="vista vista--cargando" aria-live="polite">
      <svg class="spinner" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.75" opacity="0.25"></circle>
        <path d="M21.5 12a9.5 9.5 0 0 0-9.5-9.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
      </svg>
      <p id="cargando-texto">Comprobando sesión…</p>
    </section>

    <section class="vista vista--login" aria-labelledby="login-title">
      <div class="panel-login">
        <p class="eyebrow">{site.nombre}</p>
        <h1 id="login-title">Control de asistencia</h1>
        <p class="login__intro">Acceso exclusivo para el equipo administrador.</p>

        <form id="form-login" novalidate>
          <div class="campo">
            <label for="login-correo">Correo</label>
            <input id="login-correo" name="correo" type="email" autocomplete="username" required />
          </div>
          <div class="campo">
            <label for="login-clave">Contraseña</label>
            <input id="login-clave" name="clave" type="password" autocomplete="current-password" required />
          </div>

          <p class="mensaje mensaje--error" id="login-error" role="alert" hidden></p>
          <button class="boton boton--primario boton--ancho" type="submit" id="login-enviar">Entrar</button>
        </form>
      </div>
    </section>

    <section class="vista vista--dashboard" aria-labelledby="dash-title">
      <header class="dash__head">
        <div>
          <p class="eyebrow">{site.nombre}</p>
          <h1 id="dash-title">Control de asistencia</h1>
          <p class="dash__fecha">7 de agosto de 2026 · {site.recinto}</p>
        </div>
        <div class="dash__acciones">
          <a class="boton boton--linea" href={rutaAdmin}>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="M3 4.5h14M3 10h14M3 15.5h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            Ventas
          </a>
          <button class="boton boton--fantasma" type="button" id="btn-logout">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="M7.5 17.5h-3A1.5 1.5 0 0 1 3 16V4a1.5 1.5 0 0 1 1.5-1.5h3M13 14l4-4-4-4M17 10H7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            Cerrar sesión
          </button>
        </div>
      </header>

      <p class="mensaje" id="estado-datos" role="status">Sincronizando registros…</p>
      <p class="mensaje mensaje--aviso" id="aviso" role="status" hidden></p>

      <div class="metricas" aria-label="Resumen de asistencia">
        <article class="metrica">
          <p class="metrica__etiqueta">Registradas</p>
          <p class="metrica__valor" id="metrica-total">0</p>
        </article>
        <article class="metrica metrica--llegaron">
          <p class="metrica__etiqueta">Ya llegaron</p>
          <p class="metrica__valor" id="metrica-llegaron">0</p>
        </article>
        <article class="metrica">
          <p class="metrica__etiqueta">Por llegar</p>
          <p class="metrica__valor" id="metrica-pendientes">0</p>
        </article>
      </div>

      <div class="controles">
        <div class="buscador">
          <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="m17 17-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
          <label for="buscador" class="sr-only">Buscar por nombre, empresa o teléfono</label>
          <input id="buscador" type="search" placeholder="Buscar nombre, empresa o teléfono" autocomplete="off" />
        </div>
        <button class="boton boton--linea" type="button" id="btn-actualizar">
          <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
            <path d="M16.5 7A7 7 0 1 0 17 11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            <path d="M13 3.5h3.5V7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Actualizar compras
        </button>
        <button class="boton boton--primario" type="button" id="btn-agregar">
          <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
            <path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
          </svg>
          Agregar persona
        </button>
      </div>

      <div class="filtros" role="group" aria-label="Filtrar registros">
        <button class="filtro" type="button" data-filtro="todos" aria-pressed="true">
          Todos <span id="filtro-total">0</span>
        </button>
        <button class="filtro" type="button" data-filtro="pendientes" aria-pressed="false">
          Por llegar <span id="filtro-pendientes">0</span>
        </button>
        <button class="filtro" type="button" data-filtro="llegados" aria-pressed="false">
          Ya llegaron <span id="filtro-llegados">0</span>
        </button>
      </div>

      <div class="tabla-wrap" id="tabla-wrap" hidden>
        <table class="tabla">
          <thead>
            <tr>
              <th scope="col">Nombre</th>
              <th scope="col">Contacto</th>
              <th scope="col">Empresa / granja</th>
              <th scope="col">Origen</th>
              <th scope="col">Llegada</th>
              <th scope="col"><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody id="tabla-cuerpo"></tbody>
        </table>
        <ul class="tarjetas" id="tarjetas" role="list"></ul>
      </div>

      <div class="vacio" id="vacio">
        <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
          <circle cx="12" cy="8" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M5.5 20c.5-4 2.65-6 6.5-6s6 2 6.5 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <p id="vacio-texto">Todavía no hay registros.</p>
      </div>

      <dialog class="dialogo" id="dialogo-manual" aria-labelledby="dialogo-title">
        <form id="form-manual" novalidate>
          <div class="dialogo__head">
            <div>
              <p class="eyebrow">Lista privada</p>
              <h2 id="dialogo-title">Agregar persona</h2>
            </div>
            <button class="dialogo__cerrar" type="button" id="btn-cerrar-dialogo" aria-label="Cerrar">
              <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                <path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </button>
          </div>

          <div class="campo">
            <label for="manual-nombre">Nombre completo <span aria-hidden="true">*</span></label>
            <input id="manual-nombre" name="nombre" autocomplete="name" maxlength="160" required />
          </div>
          <div class="campos-dobles">
            <div class="campo">
              <label for="manual-telefono">Teléfono</label>
              <input id="manual-telefono" name="telefono" type="tel" autocomplete="tel" maxlength="40" />
            </div>
            <div class="campo">
              <label for="manual-correo">Correo</label>
              <input id="manual-correo" name="correo" type="email" autocomplete="email" maxlength="160" />
            </div>
          </div>
          <div class="campos-dobles campos-dobles--cantidad">
            <div class="campo">
              <label for="manual-empresa">Empresa / granja</label>
              <input id="manual-empresa" name="empresa" maxlength="160" />
            </div>
            <div class="campo">
              <label for="manual-cantidad">Personas</label>
              <input id="manual-cantidad" name="cantidad" value="1" inputmode="numeric" pattern="[0-9]*" maxlength="2" />
            </div>
          </div>

          <p class="mensaje mensaje--error" id="manual-error" role="alert" hidden></p>
          <div class="dialogo__acciones">
            <button class="boton boton--fantasma" type="button" id="btn-cancelar-dialogo">Cancelar</button>
            <button class="boton boton--primario" type="submit" id="btn-guardar-manual">Guardar en la lista</button>
          </div>
        </form>
      </dialog>
    </section>
  </main>
</Base>

<script>
  import { firebaseListo } from '../scripts/admin/firebase.js';
  import { obtenerAutorizacionAdmin } from '../scripts/admin/autorizacion.js';
  import { obtenerAsistentes } from '../scripts/admin/asistentes.js';
  import {
    agregarRegistroManual,
    cambiarLlegadas,
    combinarRegistros,
    normalizaBusqueda,
    suscribirRegistros,
  } from '../scripts/admin/asistencia.js';

  const main = document.querySelector<HTMLElement>('.asistencia');
  const textoCargando = document.querySelector<HTMLParagraphElement>('#cargando-texto');
  const formLogin = document.querySelector<HTMLFormElement>('#form-login');
  const inputCorreo = document.querySelector<HTMLInputElement>('#login-correo');
  const inputClave = document.querySelector<HTMLInputElement>('#login-clave');
  const loginError = document.querySelector<HTMLParagraphElement>('#login-error');
  const botonLogin = document.querySelector<HTMLButtonElement>('#login-enviar');
  const botonLogout = document.querySelector<HTMLButtonElement>('#btn-logout');
  const estadoDatos = document.querySelector<HTMLParagraphElement>('#estado-datos');
  const aviso = document.querySelector<HTMLParagraphElement>('#aviso');
  const metricaTotal = document.querySelector<HTMLParagraphElement>('#metrica-total');
  const metricaLlegaron = document.querySelector<HTMLParagraphElement>('#metrica-llegaron');
  const metricaPendientes = document.querySelector<HTMLParagraphElement>('#metrica-pendientes');
  const buscador = document.querySelector<HTMLInputElement>('#buscador');
  const botonActualizar = document.querySelector<HTMLButtonElement>('#btn-actualizar');
  const botonAgregar = document.querySelector<HTMLButtonElement>('#btn-agregar');
  const filtros = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filtro]'));
  const filtroTotal = document.querySelector<HTMLSpanElement>('#filtro-total');
  const filtroPendientes = document.querySelector<HTMLSpanElement>('#filtro-pendientes');
  const filtroLlegados = document.querySelector<HTMLSpanElement>('#filtro-llegados');
  const tablaWrap = document.querySelector<HTMLDivElement>('#tabla-wrap');
  const tablaCuerpo = document.querySelector<HTMLTableSectionElement>('#tabla-cuerpo');
  const tarjetas = document.querySelector<HTMLUListElement>('#tarjetas');
  const vacio = document.querySelector<HTMLDivElement>('#vacio');
  const vacioTexto = document.querySelector<HTMLParagraphElement>('#vacio-texto');
  const dialogo = document.querySelector<HTMLDialogElement>('#dialogo-manual');
  const formManual = document.querySelector<HTMLFormElement>('#form-manual');
  const manualNombre = document.querySelector<HTMLInputElement>('#manual-nombre');
  const manualTelefono = document.querySelector<HTMLInputElement>('#manual-telefono');
  const manualCorreo = document.querySelector<HTMLInputElement>('#manual-correo');
  const manualEmpresa = document.querySelector<HTMLInputElement>('#manual-empresa');
  const manualCantidad = document.querySelector<HTMLInputElement>('#manual-cantidad');
  const manualError = document.querySelector<HTMLParagraphElement>('#manual-error');
  const botonGuardarManual = document.querySelector<HTMLButtonElement>('#btn-guardar-manual');

  const formatoHora = new Intl.DateTimeFormat('es-MX', {
    hour: 'numeric',
    minute: '2-digit',
  });

  let dbActual: any = null;
  let dbModActual: any = null;
  let usuarioActual: any = null;
  let cancelarSuscripcion: (() => void) | null = null;
  let asistentesStripe: any[] = [];
  let registrosGuardados: any[] = [];
  let registros: any[] = [];
  let filtroActivo = 'todos';
  let cargandoStripe = false;
  let intentoAuth = 0;
  const ocupados = new Set<string>();

  function escapaHtml(valor: unknown) {
    return String(valor ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function textoOrigen(registro: any) {
    return registro.origen === 'stripe' ? 'Compra pagada' : 'Lista manual';
  }

  function estadoRegistro(registro: any) {
    if (registro.cantidadLlegadas <= 0) return 'pendiente';
    if (registro.cantidadLlegadas >= registro.cantidad) return 'completo';
    return 'parcial';
  }

  function textoLlegada(registro: any) {
    if (!registro.ultimaLlegada) return 'Aún no llega';
    const hora = formatoHora.format(registro.ultimaLlegada);
    return registro.actualizadoPorCorreo ? `${hora} · ${registro.actualizadoPorCorreo}` : hora;
  }

  function controlLlegada(registro: any) {
    const id = escapaHtml(registro.id);
    const nombre = escapaHtml(registro.nombre);
    const ocupado = ocupados.has(registro.id);
    const completo = registro.cantidadLlegadas >= registro.cantidad;

    if (registro.cantidad === 1) {
      return completo
        ? `<button class="accion-llegada accion-llegada--lista" type="button" data-id="${id}" data-delta="-1" aria-label="Deshacer llegada de ${nombre}" ${ocupado ? 'disabled' : ''}>
            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Llegó <span>Deshacer</span>
          </button>`
        : `<button class="accion-llegada" type="button" data-id="${id}" data-delta="1" aria-label="Registrar llegada de ${nombre}" ${ocupado ? 'disabled' : ''}>
            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Registrar llegada
          </button>`;
    }

    return `<div class="contador-llegadas" aria-label="${registro.cantidadLlegadas} de ${registro.cantidad} personas llegaron">
      <button type="button" data-id="${id}" data-delta="-1" aria-label="Restar una llegada de ${nombre}" ${registro.cantidadLlegadas <= 0 || ocupado ? 'disabled' : ''}>−</button>
      <strong>${registro.cantidadLlegadas} / ${registro.cantidad}</strong>
      <button type="button" data-id="${id}" data-delta="1" aria-label="Sumar una llegada de ${nombre}" ${completo || ocupado ? 'disabled' : ''}>+</button>
    </div>`;
  }

  function coincideBusqueda(registro: any, consulta: string) {
    if (!consulta) return true;
    return [registro.nombre, registro.empresa, registro.telefono, registro.correo]
      .some((valor) => normalizaBusqueda(valor).includes(consulta));
  }

  function listaVisible() {
    const consulta = normalizaBusqueda(buscador?.value);
    const lista = registros.filter((registro) => {
      if (!coincideBusqueda(registro, consulta)) return false;
      if (filtroActivo === 'pendientes') return registro.cantidadLlegadas < registro.cantidad;
      if (filtroActivo === 'llegados') return registro.cantidadLlegadas > 0;
      return true;
    });

    return lista.sort((a, b) => {
      if (filtroActivo === 'llegados') {
        const diferencia = (b.ultimaLlegada?.getTime() ?? 0) - (a.ultimaLlegada?.getTime() ?? 0);
        if (diferencia) return diferencia;
      }
      return a.nombre.localeCompare(b.nombre, 'es-MX', { sensitivity: 'base' });
    });
  }

  function pintar() {
    if (!tablaCuerpo || !tarjetas || !tablaWrap || !vacio || !vacioTexto) return;

    const total = registros.reduce((suma, registro) => suma + registro.cantidad, 0);
    const llegaron = registros.reduce((suma, registro) => suma + registro.cantidadLlegadas, 0);
    const pendientes = Math.max(0, total - llegaron);
    if (metricaTotal) metricaTotal.textContent = String(total);
    if (metricaLlegaron) metricaLlegaron.textContent = String(llegaron);
    if (metricaPendientes) metricaPendientes.textContent = String(pendientes);
    if (filtroTotal) filtroTotal.textContent = String(total);
    if (filtroPendientes) filtroPendientes.textContent = String(pendientes);
    if (filtroLlegados) filtroLlegados.textContent = String(llegaron);

    const lista = listaVisible();
    tablaCuerpo.innerHTML = '';
    tarjetas.innerHTML = '';

    for (const registro of lista) {
      const estado = estadoRegistro(registro);
      const contacto = registro.telefono || registro.correo || '—';
      const fila = document.createElement('tr');
      fila.dataset.estadoLlegada = estado;
      fila.innerHTML = `
        <td><strong>${escapaHtml(registro.nombre)}</strong>${registro.cantidad > 1 ? `<small>${registro.cantidad} personas</small>` : ''}</td>
        <td>${escapaHtml(contacto)}</td>
        <td>${escapaHtml(registro.empresa || '—')}</td>
        <td><span class="origen" data-origen="${registro.origen}">${textoOrigen(registro)}</span></td>
        <td><span class="llegada" data-estado="${estado}">${escapaHtml(textoLlegada(registro))}</span></td>
        <td>${controlLlegada(registro)}</td>
      `;
      tablaCuerpo.appendChild(fila);

      const tarjeta = document.createElement('li');
      tarjeta.className = 'tarjeta-registro';
      tarjeta.dataset.estadoLlegada = estado;
      tarjeta.innerHTML = `
        <div class="tarjeta-registro__head">
          <div>
            <p class="tarjeta-registro__nombre">${escapaHtml(registro.nombre)}</p>
            <p class="tarjeta-registro__origen">${textoOrigen(registro)}${registro.cantidad > 1 ? ` · ${registro.cantidad} personas` : ''}</p>
          </div>
          <span class="llegada" data-estado="${estado}">${estado === 'completo' ? 'Completo' : estado === 'parcial' ? 'Parcial' : 'Pendiente'}</span>
        </div>
        <dl>
          <div><dt>Contacto</dt><dd>${escapaHtml(contacto)}</dd></div>
          <div><dt>Empresa / granja</dt><dd>${escapaHtml(registro.empresa || '—')}</dd></div>
          <div><dt>Última llegada</dt><dd>${escapaHtml(textoLlegada(registro))}</dd></div>
        </dl>
        <div class="tarjeta-registro__accion">${controlLlegada(registro)}</div>
      `;
      tarjetas.appendChild(tarjeta);
    }

    const hayLista = lista.length > 0;
    tablaWrap.hidden = !hayLista;
    vacio.hidden = hayLista;
    if (!hayLista) {
      const hayConsulta = Boolean(normalizaBusqueda(buscador?.value));
      vacioTexto.textContent = hayConsulta
        ? 'No encontramos coincidencias con esa búsqueda.'
        : filtroActivo === 'llegados'
          ? 'Todavía no se ha registrado ninguna llegada.'
          : filtroActivo === 'pendientes'
            ? 'Todos los registros ya están completos.'
            : 'Todavía no hay registros.';
    }
  }

  function actualizarCombinacion() {
    registros = combinarRegistros(asistentesStripe, registrosGuardados);
    pintar();
  }

  let temporizadorAviso: number | null = null;
  function mostrarAviso(texto: string, tipo: 'ok' | 'error' = 'ok') {
    if (!aviso) return;
    aviso.textContent = texto;
    aviso.dataset.tipo = tipo;
    aviso.hidden = false;
    if (temporizadorAviso) window.clearTimeout(temporizadorAviso);
    temporizadorAviso = window.setTimeout(() => {
      aviso.hidden = true;
    }, 4500);
  }

  async function cargarStripe() {
    if (!dbActual || !dbModActual || cargandoStripe) return;
    cargandoStripe = true;
    if (botonActualizar) botonActualizar.disabled = true;
    if (estadoDatos) {
      estadoDatos.hidden = false;
      estadoDatos.dataset.tipo = 'info';
      estadoDatos.textContent = 'Actualizando compras pagadas desde Stripe…';
    }

    try {
      asistentesStripe = await obtenerAsistentes(dbModActual, dbActual);
      actualizarCombinacion();
      if (estadoDatos) estadoDatos.hidden = true;
    } catch (error) {
      console.error('[asistencia] No se pudo leer Stripe:', error);
      if (estadoDatos) {
        estadoDatos.hidden = false;
        estadoDatos.dataset.tipo = 'error';
        estadoDatos.textContent = 'No se pudieron actualizar las compras. Los registros guardados siguen disponibles.';
      }
    } finally {
      cargandoStripe = false;
      if (botonActualizar) botonActualizar.disabled = false;
    }
  }

  function detenerDatos() {
    cancelarSuscripcion?.();
    cancelarSuscripcion = null;
    dbActual = null;
    dbModActual = null;
    usuarioActual = null;
    asistentesStripe = [];
    registrosGuardados = [];
    registros = [];
    ocupados.clear();
    pintar();
  }

  function iniciarDatos(db: any, dbMod: any, usuario: any) {
    dbActual = db;
    dbModActual = dbMod;
    usuarioActual = usuario;

    cancelarSuscripcion = suscribirRegistros(
      dbMod,
      db,
      (lista) => {
        registrosGuardados = lista;
        actualizarCombinacion();
      },
      (error) => {
        console.error('[asistencia] No se pudo sincronizar Firestore:', error);
        if (estadoDatos) {
          estadoDatos.hidden = false;
          estadoDatos.dataset.tipo = 'error';
          estadoDatos.textContent = 'No se pudo sincronizar la asistencia. Revisa la conexión o los permisos.';
        }
      }
    );

    cargarStripe();
  }

  async function manejarLlegada(evento: Event) {
    const boton = (evento.target as HTMLElement).closest<HTMLButtonElement>('button[data-delta][data-id]');
    if (!boton || !dbActual || !dbModActual || !usuarioActual) return;
    const registro = registros.find((item) => item.id === boton.dataset.id);
    const delta = Number(boton.dataset.delta);
    if (!registro || !Number.isInteger(delta) || ocupados.has(registro.id)) return;

    ocupados.add(registro.id);
    pintar();
    try {
      await cambiarLlegadas(dbModActual, dbActual, registro, delta, usuarioActual);
      mostrarAviso(delta > 0 ? `Llegada registrada: ${registro.nombre}.` : `Se deshizo la llegada de ${registro.nombre}.`);
    } catch (error) {
      console.error('[asistencia] No se pudo guardar la llegada:', error);
      mostrarAviso('No se pudo guardar el cambio. Inténtalo nuevamente.', 'error');
    } finally {
      ocupados.delete(registro.id);
      pintar();
    }
  }

  tablaCuerpo?.addEventListener('click', manejarLlegada);
  tarjetas?.addEventListener('click', manejarLlegada);
  buscador?.addEventListener('input', pintar);
  botonActualizar?.addEventListener('click', cargarStripe);

  filtros.forEach((boton) => {
    boton.addEventListener('click', () => {
      filtroActivo = boton.dataset.filtro || 'todos';
      filtros.forEach((item) => item.setAttribute('aria-pressed', String(item === boton)));
      pintar();
    });
  });

  function cerrarDialogo() {
    dialogo?.close();
  }

  botonAgregar?.addEventListener('click', () => {
    if (!dialogo) return;
    if (manualError) manualError.hidden = true;
    dialogo.showModal();
    manualNombre?.focus();
  });
  document.querySelector('#btn-cerrar-dialogo')?.addEventListener('click', cerrarDialogo);
  document.querySelector('#btn-cancelar-dialogo')?.addEventListener('click', cerrarDialogo);

  formManual?.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    if (!dbActual || !dbModActual || !usuarioActual || !manualNombre || !manualCantidad || !botonGuardarManual || !manualError) return;

    const nombre = manualNombre.value.trim();
    const cantidad = Number(manualCantidad.value);
    manualError.hidden = true;
    if (!nombre) {
      manualError.textContent = 'Escribe el nombre de la persona.';
      manualError.hidden = false;
      manualNombre.focus();
      return;
    }
    if (!Number.isInteger(cantidad) || cantidad < 1 || cantidad > 20) {
      manualError.textContent = 'La cantidad debe ser un número entre 1 y 20.';
      manualError.hidden = false;
      manualCantidad.focus();
      return;
    }

    botonGuardarManual.disabled = true;
    try {
      await agregarRegistroManual(
        dbModActual,
        dbActual,
        {
          nombre,
          telefono: manualTelefono?.value,
          correo: manualCorreo?.value,
          empresa: manualEmpresa?.value,
          cantidad,
        },
        usuarioActual
      );
      formManual.reset();
      manualCantidad.value = '1';
      cerrarDialogo();
      mostrarAviso(`${nombre} se agregó a la lista.`);
    } catch (error) {
      console.error('[asistencia] No se pudo agregar el registro:', error);
      manualError.textContent = 'No se pudo guardar la persona. Revisa la conexión e inténtalo nuevamente.';
      manualError.hidden = false;
    } finally {
      botonGuardarManual.disabled = false;
    }
  });

  const MENSAJES_ERROR: Record<string, string> = {
    'auth/invalid-email': 'El correo no tiene un formato válido.',
    'auth/user-disabled': 'Esta cuenta está deshabilitada.',
    'auth/too-many-requests': 'Demasiados intentos. Espera un momento e inténtalo de nuevo.',
  };

  (async () => {
    const { auth, db, authMod, dbMod } = await firebaseListo();

    formLogin?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!inputCorreo || !inputClave || !loginError || !botonLogin) return;
      loginError.hidden = true;
      botonLogin.disabled = true;
      try {
        await authMod.signInWithEmailAndPassword(auth, inputCorreo.value.trim(), inputClave.value);
        inputClave.value = '';
      } catch (error: any) {
        loginError.textContent = MENSAJES_ERROR[error?.code] ?? 'Correo o contraseña incorrectos.';
        loginError.hidden = false;
      } finally {
        botonLogin.disabled = false;
      }
    });

    botonLogout?.addEventListener('click', () => authMod.signOut(auth));

    authMod.onAuthStateChanged(auth, async (usuario: any) => {
      const intento = ++intentoAuth;
      detenerDatos();
      if (!main) return;

      if (!usuario) {
        main.dataset.auth = 'out';
        return;
      }

      main.dataset.auth = 'cargando';
      if (textoCargando) textoCargando.textContent = 'Verificando permisos de administrador…';
      try {
        const permiso = await obtenerAutorizacionAdmin(dbMod, db, usuario);
        if (intento !== intentoAuth) return;
        if (!permiso.autorizado) {
          await authMod.signOut(auth);
          if (loginError) {
            loginError.textContent = 'Esta cuenta existe, pero no está autorizada como administradora.';
            loginError.hidden = false;
          }
          return;
        }

        main.dataset.auth = 'in';
        iniciarDatos(db, dbMod, usuario);
      } catch (error) {
        console.error('[asistencia] No se pudo verificar la autorización:', error);
        await authMod.signOut(auth);
        if (loginError) {
          loginError.textContent = 'No se pudo verificar el acceso. Recarga la página e inténtalo de nuevo.';
          loginError.hidden = false;
        }
      }
    });
  })().catch((error) => {
    console.error('[asistencia] No se pudo inicializar Firebase:', error);
    if (main) main.dataset.auth = 'error-init';
    if (textoCargando) textoCargando.textContent = 'No se pudo iniciar el control de asistencia. Recarga la página.';
  });
</script>
