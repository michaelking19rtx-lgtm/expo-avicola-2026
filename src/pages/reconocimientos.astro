---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { asset } from '../scripts/paths.js';
import '../styles/asistencia.css';
import '../styles/reconocimientos.css';

const rutaAdmin = `${import.meta.env.BASE_URL}admin/`;
const fondoReconocimiento = asset('img/reconocimientos/fondo-reconocimiento.jpg');
const logoReconocimiento = asset('img/reconocimientos/logo-avipro-oficial.png');
const emblemaReconocimiento = asset('img/reconocimientos/emblema-inferior.png');
const firmasReconocimiento = asset('img/reconocimientos/firmas-oficiales.png');
---

<Base title={`Reconocimientos — ${site.nombre}`} noindex>
  <main class="asistencia reconocimientos" data-auth="cargando">
    <noscript>
      <p class="asistencia__noscript">El generador de reconocimientos necesita JavaScript para funcionar.</p>
    </noscript>

    <section class="vista vista--cargando" aria-live="polite">
      <svg class="spinner" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.75" opacity="0.25"></circle>
        <path d="M21.5 12a9.5 9.5 0 0 0-9.5-9.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
      </svg>
      <p id="cargando-texto">Comprobando sesión…</p>
    </section>

    <section class="vista vista--login" aria-labelledby="login-title">
      <div class="panel-login">
        <p class="eyebrow">{site.nombre}</p>
        <h1 id="login-title">Reconocimientos</h1>
        <p class="login__intro">Acceso exclusivo para el equipo administrador.</p>

        <form id="form-login" novalidate>
          <div class="campo">
            <label for="login-correo">Correo</label>
            <input id="login-correo" name="correo" type="email" autocomplete="username" required />
          </div>
          <div class="campo">
            <label for="login-clave">Contraseña</label>
            <input id="login-clave" name="clave" type="password" autocomplete="current-password" required />
          </div>
          <p class="mensaje mensaje--error" id="login-error" role="alert" hidden></p>
          <button class="boton boton--primario boton--ancho" type="submit" id="login-enviar">Entrar</button>
        </form>
      </div>
    </section>

    <section class="vista vista--dashboard" aria-labelledby="dash-title">
      <header class="dash__head">
        <div>
          <p class="eyebrow">{site.nombre}</p>
          <h1 id="dash-title">Generador de reconocimientos</h1>
          <p class="dash__fecha">7 de agosto de 2026 · Tehuacán, Puebla</p>
        </div>
        <div class="dash__acciones">
          <a class="boton boton--linea" href={rutaAdmin}>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="m11.5 4-6 6 6 6M6 10h10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            Volver al panel
          </a>
          <button class="boton boton--fantasma" type="button" id="btn-logout">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path d="M7.5 17.5h-3A1.5 1.5 0 0 1 3 16V4a1.5 1.5 0 0 1 1.5-1.5h3M13 14l4-4-4-4M17 10H7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            Cerrar sesión
          </button>
        </div>
      </header>

      <section class="reco-intro" aria-labelledby="archivo-title">
        <div class="reco-intro__texto">
          <p class="eyebrow">Lista privada</p>
          <h2 id="archivo-title">Importa a las personas asistentes</h2>
          <p>
            Usa un Excel o CSV con una columna llamada “Nombre”. Los datos se procesan únicamente en este
            dispositivo y no se suben ni se guardan en la página.
          </p>
        </div>

        <label class="cargador" id="cargador" for="archivo-personas">
          <svg viewBox="0 0 28 28" width="28" height="28" aria-hidden="true">
            <path d="M14 19V5m0 0-5 5m5-5 5 5M5 18v4a1.5 1.5 0 0 0 1.5 1.5h15A1.5 1.5 0 0 0 23 22v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="cargador__titulo">Seleccionar Excel o CSV</span>
          <span class="cargador__nota">También puedes arrastrarlo aquí · .xlsx o .csv</span>
          <input id="archivo-personas" type="file" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" />
        </label>
      </section>

      <p class="mensaje" id="estado-archivo" role="status" hidden></p>

      <section class="reco-workspace" id="reco-workspace" hidden aria-label="Editor de reconocimientos">
        <div class="reco-panel">
          <div class="reco-resumen">
            <div>
              <p class="eyebrow">Personas listas</p>
              <p class="reco-resumen__total"><span id="total-personas">0</span> reconocimientos</p>
            </div>
            <button class="boton boton--linea" type="button" id="btn-agregar">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                <path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
              Agregar
            </button>
          </div>

          <div class="reco-avisos" id="reco-avisos" hidden></div>

          <div class="buscador reco-buscador">
            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="m17 17-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            <label for="buscar-persona" class="sr-only">Buscar una persona</label>
            <input id="buscar-persona" type="search" placeholder="Buscar una persona" autocomplete="off" />
          </div>

          <ul class="personas" id="lista-personas" aria-label="Personas importadas"></ul>
          <p class="reco-sin-resultados" id="sin-resultados" hidden>No hay coincidencias con esa búsqueda.</p>

          <form class="reco-editor" id="form-persona">
            <div class="campo">
              <label for="nombre-persona">Nombre que aparecerá en el reconocimiento</label>
              <input id="nombre-persona" maxlength="160" autocomplete="off" required />
            </div>
            <p class="reco-editor__ayuda" id="ayuda-nombre">Selecciona un nombre para revisarlo.</p>
            <p class="mensaje mensaje--error" id="error-persona" role="alert" hidden></p>
            <div class="reco-editor__acciones">
              <button class="boton boton--fantasma" type="button" id="btn-eliminar" disabled>Eliminar</button>
              <button class="boton boton--primario" type="submit" id="btn-guardar">Guardar cambio</button>
            </div>
          </form>

          <details class="reco-config" open>
            <summary>Datos del reconocimiento</summary>
            <div class="reco-config__contenido">
              <div class="campo">
                <label for="texto-reconocimiento">Texto de participación</label>
                <textarea id="texto-reconocimiento" rows="4" maxlength="420">Por su valiosa participación como asistente en la Expo Avícola Productiva 2026 y por su compromiso con la formación, la innovación y el fortalecimiento del sector avícola.</textarea>
              </div>
              <div class="campo">
                <label for="fecha-reconocimiento">Fecha y lugar</label>
                <input id="fecha-reconocimiento" maxlength="160" value="7 de agosto de 2026 · Tehuacán, Puebla, México" />
              </div>
              <div class="reco-config__oficial">
                <img src={firmasReconocimiento} width="613" height="123" alt="Firmas oficiales de Jesus Alberto Betanzo, Ricardo Olmos Rivera y Comité Organizador" />
                <p>Se aplicarán las tres firmas oficiales proporcionadas para el evento.</p>
              </div>
            </div>
          </details>
        </div>

        <div class="reco-salida">
          <div class="reco-salida__head">
            <div>
              <p class="eyebrow">Vista previa</p>
              <h2>Reconocimiento de participación</h2>
            </div>
            <span class="reco-folio" id="folio-preview">EAP-2026-001</span>
          </div>

          <article
            class="reco-hoja"
            aria-label="Vista previa del reconocimiento"
            data-fondo={fondoReconocimiento}
            data-logo={logoReconocimiento}
            data-emblema={emblemaReconocimiento}
            data-firmas={firmasReconocimiento}
          >
            <img class="reco-hoja__fondo" src={fondoReconocimiento} width="1492" height="1054" alt="" aria-hidden="true" />
            <img class="reco-hoja__logo-principal" src={logoReconocimiento} width="309" height="157" alt="1er Expo Avipró 2026" />
            <h3>RECONOCIMIENTO</h3>
            <p class="reco-hoja__tipo">DE PARTICIPACIÓN</p>
            <p class="reco-hoja__otorga">Se otorga a</p>
            <p class="reco-hoja__nombre" id="preview-nombre">Nombre de la persona</p>
            <span class="reco-hoja__linea" aria-hidden="true"></span>
            <p class="reco-hoja__texto" id="preview-texto">Por su valiosa participación como asistente en la Expo Avícola Productiva 2026 y por su compromiso con la formación, la innovación y el fortalecimiento del sector avícola.</p>
            <p class="reco-hoja__fecha" id="preview-fecha">7 DE AGOSTO DE 2026 · TEHUACÁN, PUEBLA, MÉXICO</p>
            <div class="reco-hoja__sello" aria-hidden="true"><span>PARTICIPACIÓN</span><strong>2026</strong><span>COMPROMISO</span></div>
            <img class="reco-hoja__firmas-oficiales" src={firmasReconocimiento} width="613" height="123" alt="Firmas oficiales" />
            <img class="reco-hoja__emblema" src={emblemaReconocimiento} width="438" height="640" alt="" aria-hidden="true" />
          </article>

          <div class="reco-descargas">
            <button class="boton boton--linea" type="button" id="btn-descargar-uno" disabled>
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                <path d="M10 2.5v10m0 0-3.5-3.5M10 12.5 13.5 9M3.5 15v1.5a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              Descargar seleccionado
            </button>
            <button class="boton boton--primario" type="button" id="btn-descargar-todos" disabled>
              Descargar todos en un PDF
            </button>
          </div>
          <p class="reco-privacidad">Cada persona ocupa una página A4 horizontal. El PDF general conserva el orden de esta lista.</p>
        </div>
      </section>
    </section>
  </main>
</Base>

<script>
  import { firebaseListo } from '../scripts/admin/firebase.js';
  import { obtenerAutorizacionAdmin } from '../scripts/admin/autorizacion.js';

  type Persona = { id: string; nombre: string; revision: string | null };

  const main = document.querySelector<HTMLElement>('.reconocimientos');
  const textoCargando = document.querySelector<HTMLParagraphElement>('#cargando-texto');
  const formLogin = document.querySelector<HTMLFormElement>('#form-login');
  const inputCorreo = document.querySelector<HTMLInputElement>('#login-correo');
  const inputClave = document.querySelector<HTMLInputElement>('#login-clave');
  const loginError = document.querySelector<HTMLParagraphElement>('#login-error');
  const botonLogin = document.querySelector<HTMLButtonElement>('#login-enviar');
  const botonLogout = document.querySelector<HTMLButtonElement>('#btn-logout');
  const inputArchivo = document.querySelector<HTMLInputElement>('#archivo-personas');
  const cargador = document.querySelector<HTMLLabelElement>('#cargador');
  const estadoArchivo = document.querySelector<HTMLParagraphElement>('#estado-archivo');
  const workspace = document.querySelector<HTMLElement>('#reco-workspace');
  const totalPersonas = document.querySelector<HTMLSpanElement>('#total-personas');
  const avisos = document.querySelector<HTMLDivElement>('#reco-avisos');
  const buscador = document.querySelector<HTMLInputElement>('#buscar-persona');
  const lista = document.querySelector<HTMLUListElement>('#lista-personas');
  const sinResultados = document.querySelector<HTMLParagraphElement>('#sin-resultados');
  const botonAgregar = document.querySelector<HTMLButtonElement>('#btn-agregar');
  const formPersona = document.querySelector<HTMLFormElement>('#form-persona');
  const inputNombre = document.querySelector<HTMLInputElement>('#nombre-persona');
  const ayudaNombre = document.querySelector<HTMLParagraphElement>('#ayuda-nombre');
  const errorPersona = document.querySelector<HTMLParagraphElement>('#error-persona');
  const botonEliminar = document.querySelector<HTMLButtonElement>('#btn-eliminar');
  const botonGuardar = document.querySelector<HTMLButtonElement>('#btn-guardar');
  const previewNombre = document.querySelector<HTMLParagraphElement>('#preview-nombre');
  const previewFolio = document.querySelector<HTMLSpanElement>('#folio-preview');
  const hojaPreview = document.querySelector<HTMLElement>('.reco-hoja');
  const inputTextoReconocimiento = document.querySelector<HTMLTextAreaElement>('#texto-reconocimiento');
  const inputFechaReconocimiento = document.querySelector<HTMLInputElement>('#fecha-reconocimiento');
  const previewTexto = document.querySelector<HTMLParagraphElement>('#preview-texto');
  const previewFecha = document.querySelector<HTMLParagraphElement>('#preview-fecha');
  const botonDescargarUno = document.querySelector<HTMLButtonElement>('#btn-descargar-uno');
  const botonDescargarTodos = document.querySelector<HTMLButtonElement>('#btn-descargar-todos');

  let personas: Persona[] = [];
  let seleccionId: string | null = null;
  let intentoAuth = 0;
  let duplicadosImportados = 0;
  let moduloHoja: Awaited<ReturnType<typeof cargarModuloHoja>> | null = null;

  async function cargarModuloHoja() {
    return import('../scripts/admin/hoja-calculo.js');
  }

  function seleccionActual() {
    return personas.find((persona) => persona.id === seleccionId) ?? null;
  }

  function configuracionReconocimiento() {
    return {
      texto: inputTextoReconocimiento?.value.trim() ?? '',
      fecha: inputFechaReconocimiento?.value.trim() ?? '',
      fondoUrl: hojaPreview?.dataset.fondo ?? '',
      logoUrl: hojaPreview?.dataset.logo ?? '',
      emblemaUrl: hojaPreview?.dataset.emblema ?? '',
      firmasUrl: hojaPreview?.dataset.firmas ?? '',
    };
  }

  function actualizarPreview() {
    const persona = seleccionActual();
    const indice = persona ? personas.findIndex((item) => item.id === persona.id) : -1;
    const config = configuracionReconocimiento();
    if (previewNombre) previewNombre.textContent = persona?.nombre ?? 'Nombre de la persona';
    if (previewFolio) previewFolio.textContent = `EAP-2026-${String(Math.max(indice + 1, 1)).padStart(3, '0')}`;
    if (previewTexto) previewTexto.textContent = config.texto;
    if (previewFecha) previewFecha.textContent = config.fecha.toLocaleUpperCase('es-MX');
    if (botonDescargarUno) botonDescargarUno.disabled = !persona;
    if (botonDescargarTodos) botonDescargarTodos.disabled = personas.length === 0;
  }

  function editar(persona: Persona | null, creando = false) {
    seleccionId = persona?.id ?? null;
    if (inputNombre) inputNombre.value = persona?.nombre ?? '';
    if (botonEliminar) botonEliminar.disabled = !persona;
    if (botonGuardar) botonGuardar.textContent = creando ? 'Agregar a la lista' : 'Guardar cambio';
    if (ayudaNombre) {
      ayudaNombre.textContent = persona?.revision ?? (creando ? 'Escribe el nombre completo.' : 'El nombre está listo para generar.');
      ayudaNombre.dataset.tipo = persona?.revision ? 'revision' : 'ok';
    }
    if (errorPersona) errorPersona.hidden = true;
    actualizarPreview();
  }

  function pintarLista() {
    if (!lista) return;
    lista.replaceChildren();
    const termino = buscador?.value.trim().toLocaleLowerCase('es-MX') ?? '';
    const filtradas = personas.filter((persona) => persona.nombre.toLocaleLowerCase('es-MX').includes(termino));

    filtradas.forEach((persona) => {
      const indice = personas.findIndex((item) => item.id === persona.id);
      const item = document.createElement('li');
      const boton = document.createElement('button');
      boton.type = 'button';
      boton.className = 'persona';
      boton.dataset.activa = String(persona.id === seleccionId);
      boton.setAttribute('aria-pressed', String(persona.id === seleccionId));

      const numero = document.createElement('span');
      numero.className = 'persona__numero';
      numero.textContent = String(indice + 1).padStart(2, '0');
      const nombre = document.createElement('strong');
      nombre.textContent = persona.nombre;
      boton.append(numero, nombre);

      if (persona.revision) {
        const marca = document.createElement('span');
        marca.className = 'persona__revision';
        marca.textContent = 'Revisar';
        boton.append(marca);
      }

      boton.addEventListener('click', () => {
        editar(persona);
        pintarLista();
      });
      item.append(boton);
      lista.append(item);
    });

    if (sinResultados) sinResultados.hidden = filtradas.length > 0;
    if (totalPersonas) totalPersonas.textContent = String(personas.length);
    actualizarPreview();
  }

  function pintarAvisos(duplicados: number) {
    if (!avisos) return;
    avisos.replaceChildren();
    const pendientes = personas.filter((persona) => persona.revision).length;
    if (!duplicados && !pendientes) {
      avisos.hidden = true;
      return;
    }

    const listaAvisos = document.createElement('ul');
    if (duplicados) {
      const item = document.createElement('li');
      item.textContent = `${duplicados} registro${duplicados === 1 ? '' : 's'} repetido${duplicados === 1 ? '' : 's'} se omitieron.`;
      listaAvisos.append(item);
    }
    if (pendientes) {
      const item = document.createElement('li');
      item.textContent = `${pendientes} nombre${pendientes === 1 ? '' : 's'} necesitan revisión antes del PDF final.`;
      listaAvisos.append(item);
    }
    avisos.append(listaAvisos);
    avisos.hidden = false;
  }

  function mostrarEstado(texto: string, tipo: 'ok' | 'error' | 'info' = 'info') {
    if (!estadoArchivo) return;
    estadoArchivo.textContent = texto;
    estadoArchivo.dataset.tipo = tipo;
    estadoArchivo.hidden = false;
  }

  async function importarArchivo(archivo: File) {
    mostrarEstado(`Leyendo ${archivo.name}…`);
    try {
      moduloHoja ??= await cargarModuloHoja();
      const resultado = await moduloHoja.leerLista(archivo);
      personas = resultado.personas;
      duplicadosImportados = resultado.duplicadosOmitidos;
      seleccionId = personas[0]?.id ?? null;
      if (workspace) workspace.hidden = false;
      pintarAvisos(duplicadosImportados);
      editar(personas[0] ?? null);
      pintarLista();
      mostrarEstado(
        `${personas.length} personas listas desde ${archivo.name}. El archivo se procesó localmente.`,
        'ok'
      );
    } catch (error) {
      console.error('[reconocimientos] No se pudo importar la lista:', error);
      mostrarEstado(error instanceof Error ? error.message : 'No se pudo leer el archivo.', 'error');
    } finally {
      if (inputArchivo) inputArchivo.value = '';
    }
  }

  inputArchivo?.addEventListener('change', () => {
    const archivo = inputArchivo.files?.[0];
    if (archivo) importarArchivo(archivo);
  });

  for (const evento of ['dragenter', 'dragover']) {
    cargador?.addEventListener(evento, (e) => {
      e.preventDefault();
      cargador.dataset.arrastrando = 'true';
    });
  }
  for (const evento of ['dragleave', 'drop']) {
    cargador?.addEventListener(evento, (e) => {
      e.preventDefault();
      delete cargador.dataset.arrastrando;
    });
  }
  cargador?.addEventListener('drop', (evento) => {
    const archivo = evento.dataTransfer?.files?.[0];
    if (archivo) importarArchivo(archivo);
  });

  buscador?.addEventListener('input', pintarLista);

  for (const entrada of [inputTextoReconocimiento, inputFechaReconocimiento]) {
    entrada?.addEventListener('input', actualizarPreview);
  }

  botonAgregar?.addEventListener('click', () => {
    editar(null, true);
    pintarLista();
    inputNombre?.focus();
  });

  formPersona?.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    if (!inputNombre || !errorPersona) return;
    moduloHoja ??= await cargarModuloHoja();
    const nombre = moduloHoja.prepararNombre(inputNombre.value);
    if (!nombre) {
      errorPersona.textContent = 'Escribe un nombre completo.';
      errorPersona.hidden = false;
      return;
    }
    const repetido = personas.some(
      (persona) => persona.id !== seleccionId && persona.nombre.toLocaleLowerCase('es-MX') === nombre.toLocaleLowerCase('es-MX')
    );
    if (repetido) {
      errorPersona.textContent = 'Ese nombre ya está en la lista.';
      errorPersona.hidden = false;
      return;
    }

    const revision = moduloHoja.revisarNombre(nombre);
    if (seleccionId) {
      const persona = seleccionActual();
      if (persona) {
        persona.nombre = nombre;
        persona.revision = revision;
        editar(persona);
      }
    } else {
      const persona = { id: `manual-${Date.now()}`, nombre, revision };
      personas.push(persona);
      editar(persona);
    }
    pintarAvisos(duplicadosImportados);
    pintarLista();
  });

  botonEliminar?.addEventListener('click', () => {
    const indice = personas.findIndex((persona) => persona.id === seleccionId);
    if (indice < 0) return;
    const [eliminada] = personas.splice(indice, 1);
    const siguiente = personas[Math.min(indice, personas.length - 1)] ?? null;
    editar(siguiente);
    pintarAvisos(duplicadosImportados);
    pintarLista();
    mostrarEstado(`${eliminada.nombre} se eliminó de esta lista local.`, 'info');
  });

  async function conBotonOcupado(boton: HTMLButtonElement | null, tarea: () => Promise<void>) {
    if (!boton) return;
    const texto = boton.textContent;
    boton.disabled = true;
    boton.textContent = 'Generando PDF…';
    try {
      await tarea();
    } catch (error) {
      console.error('[reconocimientos] No se pudo generar el PDF:', error);
      mostrarEstado('No se pudo generar el PDF. Recarga la página e inténtalo nuevamente.', 'error');
    } finally {
      boton.textContent = texto;
      boton.disabled = false;
      actualizarPreview();
    }
  }

  botonDescargarUno?.addEventListener('click', () => {
    const persona = seleccionActual();
    if (!persona) return;
    conBotonOcupado(botonDescargarUno, async () => {
      const { descargarReconocimiento } = await import('../scripts/admin/reconocimientos.js');
      await descargarReconocimiento(persona, personas.indexOf(persona), configuracionReconocimiento());
    });
  });

  botonDescargarTodos?.addEventListener('click', () => {
    if (!personas.length) return;
    conBotonOcupado(botonDescargarTodos, async () => {
      const { descargarReconocimientos } = await import('../scripts/admin/reconocimientos.js');
      await descargarReconocimientos(personas, configuracionReconocimiento());
    });
  });

  const MENSAJES_ERROR: Record<string, string> = {
    'auth/invalid-email': 'El correo no tiene un formato válido.',
    'auth/user-disabled': 'Esta cuenta está deshabilitada.',
    'auth/too-many-requests': 'Demasiados intentos. Espera un momento e inténtalo de nuevo.',
  };

  (async () => {
    const { auth, db, authMod, dbMod } = await firebaseListo();
    formLogin?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!inputCorreo || !inputClave || !loginError || !botonLogin) return;
      loginError.hidden = true;
      botonLogin.disabled = true;
      try {
        await authMod.signInWithEmailAndPassword(auth, inputCorreo.value.trim(), inputClave.value);
        inputClave.value = '';
      } catch (error: any) {
        loginError.textContent = MENSAJES_ERROR[error?.code] ?? 'Correo o contraseña incorrectos.';
        loginError.hidden = false;
      } finally {
        botonLogin.disabled = false;
      }
    });

    botonLogout?.addEventListener('click', () => authMod.signOut(auth));
    authMod.onAuthStateChanged(auth, async (usuario: any) => {
      const intento = ++intentoAuth;
      if (!main) return;
      if (!usuario) {
        personas = [];
        seleccionId = null;
        duplicadosImportados = 0;
        lista?.replaceChildren();
        if (workspace) workspace.hidden = true;
        if (estadoArchivo) estadoArchivo.hidden = true;
        if (inputNombre) inputNombre.value = '';
        actualizarPreview();
        main.dataset.auth = 'out';
        return;
      }

      main.dataset.auth = 'cargando';
      if (textoCargando) textoCargando.textContent = 'Verificando permisos de administrador…';
      try {
        const permiso = await obtenerAutorizacionAdmin(dbMod, db, usuario);
        if (intento !== intentoAuth) return;
        if (!permiso.autorizado) {
          await authMod.signOut(auth);
          if (loginError) {
            loginError.textContent = 'Esta cuenta existe, pero no está autorizada como administradora.';
            loginError.hidden = false;
          }
          return;
        }
        main.dataset.auth = 'in';
      } catch (error) {
        console.error('[reconocimientos] No se pudo verificar la autorización:', error);
        await authMod.signOut(auth);
        if (loginError) {
          loginError.textContent = 'No se pudo verificar el acceso. Recarga la página e inténtalo de nuevo.';
          loginError.hidden = false;
        }
      }
    });
  })().catch((error) => {
    console.error('[reconocimientos] No se pudo inicializar Firebase:', error);
    if (main) main.dataset.auth = 'error-init';
    if (textoCargando) textoCargando.textContent = 'No se pudo iniciar el generador. Recarga la página.';
  });
</script>
