---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import catalog from '../data/videos-expo.json';
import photoCatalog from '../data/fotos-expo.json';

const videos = catalog.videos;
const photos = photoCatalog.photos;
const featuredPhotos = photos.filter((photo) => photo.featured);
const morePhotos = photos.filter((photo) => !photo.featured);
const featured = videos[0] ?? null;
const categoryOrder = ['conferencias', 'panel', 'entrevistas', 'recorrido'];
const categories = categoryOrder
  .map((slug) => {
    const matches = videos.filter((video) => video.category === slug);
    return matches.length
      ? { slug, label: matches[0].categoryLabel, count: matches.length }
      : null;
  })
  .filter(Boolean);

const formatDuration = (seconds: number) => {
  const minutes = Math.floor(seconds / 60);
  const remaining = seconds % 60;
  return `${minutes}:${String(remaining).padStart(2, '0')}`;
};

const totalSeconds = videos.reduce((total, video) => total + video.duration, 0);
const totalHours = Math.floor(totalSeconds / 3600);
const totalMinutes = Math.floor((totalSeconds % 3600) / 60);
const totalDuration = totalHours ? `${totalHours} h ${totalMinutes} min` : `${totalMinutes} min`;
const progress = Math.round((catalog.publishedTotal / catalog.expectedTotal) * 100);
---

<Base
  title={`Memoria audiovisual — Expo Avícola Productiva 2026`}
  description="Conferencias, entrevistas, paneles y momentos de la Expo Avícola Productiva 2026, disponibles en video."
  noindex
>
  <Nav />

  <main class="memoria" id="contenido" tabindex="-1">
    <header class="memoria-hero">
      <div class="memoria-hero__copy">
        <p class="eyebrow">Memoria audiovisual · Tehuacán, Puebla</p>
        <h1>La expo,<br /><span>completa.</span></h1>
        <p class="memoria-hero__lead">
          Conferencias, conversaciones y momentos del encuentro que reunió al sector
          avícola el 7 de agosto de 2026. Un archivo para volver a las ideas y compartirlas.
        </p>
      </div>

      <aside class="publicacion" aria-label="Estado de publicación">
        <span class="publicacion__estado">
          <span aria-hidden="true"></span>
          {catalog.publishedTotal < catalog.expectedTotal ? 'Publicación en curso' : 'Archivo completo'}
        </span>
        <strong>{catalog.publishedTotal}<small>/{catalog.expectedTotal}</small></strong>
        <p>videos disponibles</p>
        <div class="publicacion__barra" aria-hidden="true">
          <span style={`--avance: ${progress}%`}></span>
        </div>
        <p class="publicacion__detalle">
          {totalDuration} publicados · el archivo se actualiza conforme termina cada video.
        </p>
      </aside>
    </header>

    <section class="momentos" aria-labelledby="momentos-titulo">
      <div class="momentos__cabecera">
        <div>
          <p class="eyebrow">La Expo en imágenes</p>
          <h2 id="momentos-titulo">Momentos que<br /><span>se quedan.</span></h2>
        </div>
        <div class="momentos__intro">
          <p>
            Una mirada al encuentro más allá del escenario: la comunidad, las conversaciones,
            las demostraciones y la energía que se vivió durante toda la jornada.
          </p>
          <span>{photos.length} fotografías seleccionadas · 7 de agosto de 2026</span>
        </div>
      </div>

      <div class="momentos-collage">
        {featuredPhotos.map((photo) => (
          <button
            class:list={['momento', { 'momento--vertical': photo.height > photo.width }]}
            style={photo.height > photo.width ? `--foto-fondo: url("${photo.src}")` : undefined}
            type="button"
            data-photo
            data-photo-index={photo.id - 1}
            data-photo-full={photo.full}
            data-photo-alt={photo.alt}
            data-photo-title={photo.label}
            data-photo-caption={photo.caption}
            data-photo-width={photo.width}
            data-photo-height={photo.height}
            aria-label={`Ampliar fotografía: ${photo.label}`}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
            />
            <span class="momento__copy">
              <strong>{photo.label}</strong>
              <span>{photo.caption}</span>
            </span>
          </button>
        ))}
      </div>

      <div class="momentos__mas">
        <div class="momentos__mas-cabecera">
          <div>
            <p class="eyebrow">Más momentos</p>
            <p>Desliza para seguir recorriendo el día.</p>
          </div>
          <div class="momentos__controles" aria-label="Controles de la galería">
            <button type="button" data-strip-prev aria-label="Fotografías anteriores">←</button>
            <button type="button" data-strip-next aria-label="Fotografías siguientes">→</button>
          </div>
        </div>

        <div class="momentos-tira" data-photo-strip>
          {morePhotos.map((photo) => (
            <button
              class:list={['momento-tira', { 'momento-tira--vertical': photo.height > photo.width }]}
              type="button"
              data-photo
              data-photo-index={photo.id - 1}
              data-photo-full={photo.full}
              data-photo-alt={photo.alt}
              data-photo-title={photo.label}
              data-photo-caption={photo.caption}
              data-photo-width={photo.width}
              data-photo-height={photo.height}
              aria-label={`Ampliar fotografía: ${photo.label}`}
            >
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
              />
              <span>
                <strong>{photo.label}</strong>
                <small>{photo.caption}</small>
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    {featured ? (
      <section class="reproductor" aria-labelledby="reproductor-titulo" data-player-section>
        <div class="reproductor__cabecera">
          <div>
            <p class="eyebrow" data-player-category>{featured.categoryLabel}</p>
            <h2 id="reproductor-titulo" data-player-title>{featured.title}</h2>
          </div>
          <span class="reproductor__duracion" data-player-duration>
            {formatDuration(featured.duration)}
          </span>
        </div>
        <div class="reproductor__frame">
          <iframe
            src={`${featured.embedUrl}?autoplay=false&preload=false`}
            title={`Reproducir: ${featured.title}`}
            loading="eager"
            allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
            data-player
          ></iframe>
        </div>
      </section>
    ) : (
      <section class="procesando" aria-labelledby="procesando-titulo">
        <p class="eyebrow">Preparando el archivo</p>
        <h2 id="procesando-titulo">Los primeros videos están procesándose.</h2>
        <p>Vuelve pronto: aparecerán aquí automáticamente cuando estén listos.</p>
      </section>
    )}

    {videos.length > 0 && (
      <section class="archivo" aria-labelledby="archivo-titulo">
        <div class="archivo__cabecera">
          <div>
            <p class="eyebrow">Explora el encuentro</p>
            <h2 id="archivo-titulo">Todo lo que pasó, por capítulo</h2>
          </div>
          <p class="archivo__resultado" aria-live="polite" data-result-count>
            {videos.length} {videos.length === 1 ? 'video' : 'videos'}
          </p>
        </div>

        <div class="filtros" role="group" aria-label="Filtrar videos por categoría">
          <button class="filtro" type="button" data-filter="todos" aria-pressed="true">
            Todos <span>{videos.length}</span>
          </button>
          {categories.map((category) => category && (
            <button class="filtro" type="button" data-filter={category.slug} aria-pressed="false">
              {category.label} <span>{category.count}</span>
            </button>
          ))}
        </div>

        <div class="videoteca" data-video-grid>
          {videos.map((video, index) => (
            <article class="video-card" data-category={video.category}>
              <button
                type="button"
                class="video-card__button"
                data-video-card
                data-embed={video.embedUrl}
                data-title={video.title}
                data-category-label={video.categoryLabel}
                data-duration={formatDuration(video.duration)}
                aria-label={`Reproducir ${video.title}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span class="video-card__media">
                  <img
                    src={video.thumbnailUrl}
                    alt=""
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="video-card__play" aria-hidden="true"></span>
                  <span class="video-card__time">{formatDuration(video.duration)}</span>
                </span>
                <span class="video-card__body">
                  <span class="video-card__category">{video.categoryLabel}</span>
                  <strong>{video.title}</strong>
                </span>
              </button>
            </article>
          ))}
        </div>
      </section>
    )}

    <dialog class="foto-modal" data-photo-modal aria-label="Fotografía ampliada">
      <div class="foto-modal__contenido">
        <button class="foto-modal__cerrar" type="button" data-photo-close aria-label="Cerrar fotografía">×</button>
        <button class="foto-modal__nav foto-modal__nav--prev" type="button" data-photo-prev aria-label="Fotografía anterior">←</button>
        <figure>
          <div class="foto-modal__imagen">
            <img src="" alt="" data-photo-image />
          </div>
          <figcaption>
            <p class="eyebrow" data-photo-counter></p>
            <h2 data-photo-title></h2>
            <p data-photo-caption></p>
          </figcaption>
        </figure>
        <button class="foto-modal__nav foto-modal__nav--next" type="button" data-photo-next aria-label="Fotografía siguiente">→</button>
      </div>
    </dialog>
  </main>

  <Footer />
</Base>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.video-card'));
  const videoButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-video-card]'));
  const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
  const player = document.querySelector<HTMLIFrameElement>('[data-player]');
  const playerTitle = document.querySelector<HTMLElement>('[data-player-title]');
  const playerCategory = document.querySelector<HTMLElement>('[data-player-category]');
  const playerDuration = document.querySelector<HTMLElement>('[data-player-duration]');
  const playerSection = document.querySelector<HTMLElement>('[data-player-section]');
  const photoButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo]'));
  const photoModal = document.querySelector<HTMLDialogElement>('[data-photo-modal]');
  const photoImage = photoModal?.querySelector<HTMLImageElement>('[data-photo-image]');
  const photoTitle = photoModal?.querySelector<HTMLElement>('[data-photo-title]');
  const photoCaption = photoModal?.querySelector<HTMLElement>('[data-photo-caption]');
  const photoCounter = photoModal?.querySelector<HTMLElement>('[data-photo-counter]');
  const photoStrip = document.querySelector<HTMLElement>('[data-photo-strip]');
  let activePhotoIndex = 0;
  let lastPhotoTrigger: HTMLButtonElement | null = null;

  const photoByIndex = (index: number) => photoButtons.find(
    (button) => Number(button.dataset.photoIndex) === index,
  );

  const updatePhoto = (requestedIndex: number) => {
    if (!photoButtons.length || !photoImage) return;
    activePhotoIndex = (requestedIndex + photoButtons.length) % photoButtons.length;
    const photo = photoByIndex(activePhotoIndex);
    if (!photo) return;
    photoImage.src = photo.dataset.photoFull ?? '';
    photoImage.alt = photo.dataset.photoAlt ?? '';
    photoModal?.classList.toggle(
      'foto-modal--vertical',
      Number(photo.dataset.photoHeight) > Number(photo.dataset.photoWidth),
    );
    if (photoTitle) photoTitle.textContent = photo.dataset.photoTitle ?? '';
    if (photoCaption) photoCaption.textContent = photo.dataset.photoCaption ?? '';
    if (photoCounter) photoCounter.textContent = `${activePhotoIndex + 1} de ${photoButtons.length} · Memoria fotográfica`;

    for (const neighborIndex of [activePhotoIndex - 1, activePhotoIndex + 1]) {
      const neighbor = photoByIndex((neighborIndex + photoButtons.length) % photoButtons.length);
      const source = neighbor?.dataset.photoFull;
      if (source) new Image().src = source;
    }
  };

  const movePhoto = (direction: number) => updatePhoto(activePhotoIndex + direction);

  for (const button of photoButtons) {
    button.addEventListener('click', () => {
      lastPhotoTrigger = button;
      updatePhoto(Number(button.dataset.photoIndex ?? 0));
      photoModal?.showModal();
    });
  }

  document.querySelector<HTMLElement>('[data-photo-close]')?.addEventListener('click', () => photoModal?.close());
  document.querySelector<HTMLElement>('[data-photo-prev]')?.addEventListener('click', () => movePhoto(-1));
  document.querySelector<HTMLElement>('[data-photo-next]')?.addEventListener('click', () => movePhoto(1));

  photoModal?.addEventListener('click', (event) => {
    if (event.target === photoModal) photoModal.close();
  });
  photoModal?.addEventListener('close', () => {
    if (photoImage) photoImage.src = '';
    lastPhotoTrigger?.focus();
  });
  document.addEventListener('keydown', (event) => {
    if (!photoModal?.open) return;
    if (event.key === 'ArrowLeft') movePhoto(-1);
    if (event.key === 'ArrowRight') movePhoto(1);
  });

  const scrollPhotos = (direction: number) => photoStrip?.scrollBy({
    left: direction * photoStrip.clientWidth * 0.82,
    behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
  });
  document.querySelector<HTMLElement>('[data-strip-prev]')?.addEventListener('click', () => scrollPhotos(-1));
  document.querySelector<HTMLElement>('[data-strip-next]')?.addEventListener('click', () => scrollPhotos(1));

  for (const filter of filterButtons) {
    filter.addEventListener('click', () => {
      const selected = filter.dataset.filter ?? 'todos';
      let visible = 0;
      for (const button of filterButtons) {
        button.setAttribute('aria-pressed', String(button === filter));
      }
      for (const card of cards) {
        const show = selected === 'todos' || card.dataset.category === selected;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (resultCount) resultCount.textContent = `${visible} ${visible === 1 ? 'video' : 'videos'}`;
    });
  }

  for (const button of videoButtons) {
    button.addEventListener('click', () => {
      const embed = button.dataset.embed;
      if (!embed || !player) return;
      for (const candidate of videoButtons) {
        candidate.setAttribute('aria-pressed', String(candidate === button));
      }
      player.src = `${embed}?autoplay=true&preload=true`;
      player.title = `Reproducir: ${button.dataset.title ?? 'Video de la Expo'}`;
      if (playerTitle) playerTitle.textContent = button.dataset.title ?? '';
      if (playerCategory) playerCategory.textContent = button.dataset.categoryLabel ?? '';
      if (playerDuration) playerDuration.textContent = button.dataset.duration ?? '';
      playerSection?.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start',
      });
    });
  }
</script>

<style>
  .memoria {
    padding-block-start: calc(var(--nav-h) + var(--space-2xl));
  }

  .memoria-hero,
  .momentos,
  .reproductor,
  .archivo,
  .procesando {
    width: min(100%, var(--container));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .memoria-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.55fr);
    align-items: end;
    gap: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .eyebrow {
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .memoria-hero h1 {
    max-width: 900px;
    margin-block-start: var(--space-md);
    font-size: var(--step-5);
    line-height: 0.86;
    letter-spacing: -0.055em;
  }

  .memoria-hero h1 span {
    color: var(--accent);
  }

  .memoria-hero__lead {
    max-width: 690px;
    margin-block-start: var(--space-xl);
    color: var(--text-muted);
    font-size: var(--step-1);
  }

  .momentos {
    padding-block: var(--space-3xl);
  }

  .momentos__cabecera {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.55fr);
    align-items: end;
    gap: var(--space-2xl);
    margin-block-end: var(--space-2xl);
  }

  .momentos__cabecera h2 {
    margin-block-start: var(--space-sm);
    font-size: var(--step-4);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .momentos__cabecera h2 span {
    color: var(--accent);
  }

  .momentos__intro > p {
    color: var(--text-muted);
    font-size: var(--step-1);
  }

  .momentos__intro > span {
    display: block;
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .momentos-collage {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(120px, 13vw, 205px);
    gap: var(--space-sm);
  }

  .momento,
  .momento-tira {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-align: start;
    box-shadow: var(--shadow-sm);
  }

  .momento {
    border-radius: var(--radius-media);
  }

  .momento:nth-child(1) {
    grid-column: span 7;
    grid-row: span 2;
  }

  .momento:nth-child(2),
  .momento:nth-child(3) {
    grid-column: span 5;
  }

  .momento:nth-child(4),
  .momento:nth-child(5) {
    grid-column: span 4;
    grid-row: span 2;
  }

  .momento:nth-child(6),
  .momento:nth-child(7) {
    grid-column: span 4;
  }

  .momento img,
  .momento-tira img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow) var(--ease-out);
  }

  .momento--vertical {
    isolation: isolate;
  }

  .momento--vertical::before {
    position: absolute;
    z-index: 0;
    inset: -8%;
    background-image: var(--foto-fondo);
    background-position: center;
    background-size: cover;
    content: '';
    filter: blur(18px);
    opacity: 0.42;
    transform: scale(1.08);
  }

  .momento--vertical img {
    position: relative;
    z-index: 1;
    object-fit: contain;
  }

  .momento::after,
  .momento-tira::after {
    position: absolute;
    z-index: 2;
    inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--bg) 92%, transparent), transparent 62%);
    content: '';
    pointer-events: none;
  }

  .momento:hover img,
  .momento:focus-visible img,
  .momento-tira:hover img,
  .momento-tira:focus-visible img {
    transform: scale(1.035);
  }

  .momento:focus-visible,
  .momento-tira:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .momento__copy {
    position: absolute;
    z-index: 3;
    inset: auto var(--space-lg) var(--space-lg);
    display: grid;
    gap: var(--space-xs);
    pointer-events: none;
  }

  .momento__copy strong,
  .momento-tira strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.05;
  }

  .momento__copy > span,
  .momento-tira small {
    max-width: 48ch;
    color: color-mix(in srgb, var(--text) 78%, transparent);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .momento:nth-child(2) .momento__copy > span,
  .momento:nth-child(3) .momento__copy > span,
  .momento:nth-child(6) .momento__copy > span,
  .momento:nth-child(7) .momento__copy > span {
    display: none;
  }

  .momentos__mas {
    margin-block-start: var(--space-2xl);
  }

  .momentos__mas-cabecera {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-block-end: var(--space-lg);
  }

  .momentos__mas-cabecera > div:first-child > p:last-child {
    margin-block-start: var(--space-xs);
    color: var(--text-muted);
  }

  .momentos__controles {
    display: flex;
    gap: var(--space-xs);
  }

  .momentos__controles button,
  .foto-modal__nav,
  .foto-modal__cerrar {
    display: grid;
    place-items: center;
    width: 46px;
    aspect-ratio: 1;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    font-size: 1.25rem;
    transition:
      border-color var(--t-base) var(--ease-out),
      background-color var(--t-base) var(--ease-out),
      color var(--t-base) var(--ease-out);
  }

  .momentos__controles button:hover,
  .foto-modal__nav:hover,
  .foto-modal__cerrar:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .momentos-tira {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-xs) var(--gutter) var(--space-md);
    margin-inline: calc(var(--gutter) * -1);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--accent) var(--surface-2);
  }

  .momento-tira {
    flex: 0 0 clamp(260px, 30vw, 390px);
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    scroll-snap-align: start;
  }

  .momento-tira--vertical {
    flex-basis: clamp(210px, 21vw, 270px);
    aspect-ratio: 2 / 3;
  }

  .momento-tira > span {
    position: absolute;
    z-index: 3;
    inset: auto var(--space-lg) var(--space-lg);
    display: grid;
    gap: var(--space-xs);
    pointer-events: none;
  }

  .momento-tira small {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .foto-modal {
    width: min(95vw, 1500px);
    max-width: none;
    height: min(90vh, 920px);
    max-height: none;
    padding: 0;
    overflow: visible;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }

  .foto-modal::backdrop {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
