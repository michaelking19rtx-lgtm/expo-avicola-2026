---
import { totalConferencias, enPalabra } from '../scripts/programa.js';
import { asset } from '../scripts/paths.js';

/*
  Sección de introducción al congreso.

  El video es un archivo LOCAL servido desde /public, no un embed. Es un MP4
  de 1920×1080 y 26 MB, así que la regla que gobierna este bloque es que
  nada de eso se descargue hasta que hace falta:

  - `preload="none"` — sin esto el navegador se trae al menos las cabeceras y,
    según implementación, el primer tramo del archivo. A este tamaño eso es
    inaceptable en datos móviles, que es como llega la mayor parte del tráfico
    de este sitio (ver «Revisión de móvil» en la bitácora).
  - `poster` — un WebP de 37 KB es TODO lo que pesa la sección hasta que se
    reproduce algo. Además es lo que reserva el fotograma: sin él, la caja
    quedaría vacía.
  - El `aspect-ratio: 16/9` del contenedor ya evitaba el CLS con el
    placeholder y lo sigue haciendo con el `<video>`; el poster comparte esa
    proporción exacta (960×540), así que no hay reencuadre ni salto.

  AUTOPLAY SILENCIOSO — SIN el atributo `autoplay` del marcado. Se probó a
  propósito (`<video autoplay muted loop preload="none">` fuera de la vista):
  el navegador pide el archivo igual, de inmediato, sin esperar a que entre en
  el viewport. `autoplay` le gana a `preload="none"`, así que aquí el disparo
  de la reproducción es manual, con un IntersectionObserver en el `<script>` de
  abajo, y es su `.play()` el que arranca la descarga — no antes. `muted` y
  `loop` sí son atributos estáticos: se probó también y, solos, sin
  `autoplay`, no piden nada (medido: 0 peticiones a `promo.mp4` sin ese play).
*/

/*
  El lead ABRE con el número, así que va en letra y con mayúscula inicial. Se
  compone aquí y no en la plantilla para no meter un `replace` con expresión
  regular en medio del texto, que es donde peor se lee.
*/
const cuantas = enPalabra(totalConferencias());
const Cuantas = cuantas.charAt(0).toUpperCase() + cuantas.slice(1);
---

<section class="intro" id="congreso">
  <div class="intro__inner">
    <header class="intro__head">
      <p class="intro__eyebrow" data-anim>El congreso</p>
      <h2 class="intro__title" data-anim>Un día, toda la operación avícola</h2>
      <p class="intro__lead" data-anim>
        {Cuantas} conferencias, un panel de expertos y un show de medio tiempo conectan
        los tres frentes que deciden el resultado de una granja: productividad,
        sanidad preventiva y tecnología aplicada. Entre sesiones, coffee break y
        área comercial para ver equipo y hablar de frente con proveedores.
      </p>
    </header>

    <div class="intro__player" data-anim>
      <video
        class="intro__media"
        controls
        preload="none"
        playsinline
        muted
        loop
        poster={asset('video/poster.webp')}
        width="1920"
        height="1080"
      >
        <source src={asset('video/promo.mp4')} type="video/mp4" />
        Tu navegador no puede reproducir este video.
      </video>

      {/*
        Botón de sonido. Gateado tras [data-js] en el CSS: sin autoplay no hace
        falta —el video sigue con controles nativos que ya traen volumen— y sin
        JS no tiene con qué reaccionar al clic.

        data-muted arranca PRESENTE a propósito: coincide con el estado real en
        el caso común (recién pintado, el video parte muted) y con
        prefers-reduced-motion —donde tampoco cambia, el atributo `muted` del
        marcado sigue muted hasta que alguien le dé play—. El script solo
        confirma el estado real al cargar, no lo adivina.
      */}
      <button
        type="button"
        class="intro__sonido"
        data-sonido
        data-muted
        aria-label="Activar sonido"
      >
        <svg
          class="intro__sonido-on"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M4 9.5v5h3.2l4.8 3.6V5.9L7.2 9.5H4Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
          <path
            d="M15.8 9.2a3.6 3.6 0 0 1 0 5.6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <path
            d="M18.1 6.8a7 7 0 0 1 0 10.4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
        <svg
          class="intro__sonido-off"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M4 9.5v5h3.2l4.8 3.6V5.9L7.2 9.5H4Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
          <path
            d="M15.5 9.5l5 5M20.5 9.5l-5 5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('.intro');
  const video = document.querySelector<HTMLVideoElement>('.intro__media');
  const botonSonido = document.querySelector<HTMLButtonElement>('[data-sonido]');

  // ---------------------------------------------------------------------
  // Botón de sonido. Esencial, sin dependencia de la capa de movimiento:
  // silenciar o activar el audio tiene que funcionar aunque GSAP no llegue.
  // ---------------------------------------------------------------------
  function actualizarBotonSonido(): void {
    if (!botonSonido || !video) return;
    botonSonido.toggleAttribute('data-muted', video.muted);
    botonSonido.setAttribute(
      'aria-label',
      video.muted ? 'Activar sonido' : 'Silenciar el video'
    );
  }

  if (botonSonido && video) {
    botonSonido.addEventListener('click', () => {
      video.muted = !video.muted;
      actualizarBotonSonido();
    });
    // Confirma el estado real al cargar: no se asume, se lee del propio video.
    actualizarBotonSonido();
  }

  // ---------------------------------------------------------------------
  // Autoplay silencioso al entrar en viewport (ver el comentario grande del
  // frontmatter: NO es el atributo `autoplay`, es este `.play()` manual).
  // ---------------------------------------------------------------------
  const prefiereMenosMovimiento = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (video && !prefiereMenosMovimiento) {
    const observadorVideo = new IntersectionObserver(
      (entradas, obs) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          video.play().catch(() => {
            /*
              Alguna política de autoplay lo bloqueó pese a `muted`. El video
              se queda en el póster, listo para el play manual con los
              controles nativos — nunca es un error visible.
            */
          });
          obs.disconnect();
          return;
        }
      },
      { threshold: 0.5 }
    );
    observadorVideo.observe(video);
  }
  // Con prefers-reduced-motion no se registra observer: el video se queda
  // quieto en el póster hasta que alguien pulse play a mano.

  // Import dinámico, igual que en Nav y Hero: la capa de movimiento es mejora
  // progresiva y no debe poder tumbar nada esencial.
  import('../scripts/animations.js')
    .then(({ initMotion }) => {
      const { gsap, reduced } = initMotion();
      if (reduced || !gsap || !seccion) return;

      const elementos = seccion.querySelectorAll<HTMLElement>('[data-anim]');

      gsap.fromTo(
        elementos,
        { opacity: 0, y: 32 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: seccion,
            start: 'top 78%',
            once: true,
          },
        }
      );
    })
    .catch(() => {
      /* Sin capa de movimiento: la sección ya está en su estado final. */
    });
</script>

<style>
  .intro {
    padding-block: var(--space-3xl);
  }

  .intro__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .intro__head {
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-block-end: var(--space-2xl);
    text-align: center;
  }

  .intro__eyebrow {
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .intro__title {
    margin-block-start: var(--space-sm);
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .intro__lead {
    margin-block-start: var(--space-lg);
    color: var(--text-muted);
  }

  /* Reproductor ------------------------------------------------------------ */
  .intro__player {
    position: relative;
    max-width: var(--media-max);
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  /*
    `width: 100%` + `height: auto` para que los atributos width/height del
    marcado sirvan de proporción intrínseca y no de tamaño fijo: el navegador
    reserva la caja antes de tener el poster y el video nunca desborda su
    contenedor. El `aspect-ratio` explícito lo sostiene igualmente si el
    poster fallara.

    `max-width: 100%` no es redundante con `width: 100%`: un `<video>` con
    atributo `width="1920"` toma ese valor como base intrínseca y, en el
    contenedor angosto de móvil, sin el tope llegaría a desbordar.
  */
  .intro__media {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background-color: var(--surface);
    /* El poster es 16/9 igual que la caja: `cover` no recorta nada, solo
       blinda el caso de que algún día se cambie por uno de otra proporción. */
    object-fit: cover;
  }

  /*
    Botón de sonido. Oculto sin JS —igual que .barra en BarraCompra.astro—:
    sin autoplay el video ya trae volumen en sus controles nativos, así que un
    botón inerte aquí sería puro ruido visual.
  */
  .intro__sonido {
    display: none;
  }

  :global([data-js]) .intro__sonido {
    position: absolute;
    inset-block-start: var(--space-sm);
    inset-inline-end: var(--space-sm);
    z-index: 1;

    display: grid;
    place-items: center;
    /* 44×44 reales: el mínimo de área de toque, igual que .barra__cta. */
    inline-size: 44px;
    block-size: 44px;

    border-radius: 50%;
    background-color: color-mix(in srgb, var(--bg) 55%, transparent);
    color: var(--text);
    transition: background-color var(--t-base) var(--ease-out);
  }

  :global([data-js]) .intro__sonido:hover {
    background-color: color-mix(in srgb, var(--bg) 75%, transparent);
  }

  /* Un icono a la vez: cuál se ve depende de si el botón lleva data-muted. */
  .intro__sonido-on {
    display: none;
  }

  .intro__sonido:not([data-muted]) .intro__sonido-on {
    display: block;
  }

  .intro__sonido[data-muted] .intro__sonido-off {
    display: block;
  }

  .intro__sonido:not([data-muted]) .intro__sonido-off {
    display: none;
  }
</style>
