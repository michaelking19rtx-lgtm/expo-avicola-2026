---
import site from '../data/site.json';
import { fechaLarga } from '../scripts/fechas.js';

/*
  Sede y fecha del congreso.

  Recinto y dirección ya están confirmados en site.json. El estado "Por
  confirmar" NO se borra del código: sigue aquí como respaldo, porque es la
  misma pieza que cubre a cualquier dato que vuelva a null (un cambio de sede
  de última hora, por ejemplo). Mientras el valor exista, no se ve.
*/
const datos = [
  { etiqueta: 'Fecha', valor: fechaLarga(site.fecha) },
  { etiqueta: 'Horario', valor: site.horario },
  { etiqueta: 'Ciudad', valor: site.ciudad },
  { etiqueta: 'Recinto', valor: site.recinto, pendiente: 'Por confirmar' },
  { etiqueta: 'Dirección', valor: site.direccion, pendiente: 'Por confirmar' },
];

/*
  MAPA. Las dos URLs se derivan de site.coordenadas: ni el embed ni el enlace
  llevan una coordenada escrita a mano, así que mover la sede es cambiar dos
  números en el JSON.

  `output=embed` es la incrustación de Maps que NO pide clave de API. Es la
  única vía sin dar de alta un proyecto en Google Cloud; a cambio no está
  documentada como API pública. Si algún día dejara de responder, el sustituto
  con soporte oficial es Maps Embed API (`/maps/embed/v1/place`), que sí exige
  clave.

  El enlace de abajo usa las URLs universales de Maps, esas sí documentadas.
*/
const { lat, lng } = site.coordenadas;
const puntoMapa = `${lat},${lng}`;
const mapaEmbed = `https://www.google.com/maps?q=${puntoMapa}&z=16&hl=es&output=embed`;
const mapaComoLlegar = `https://www.google.com/maps/dir/?api=1&destination=${puntoMapa}`;

// El title del iframe nombra el recinto: un iframe sin nombre accesible es un
// agujero para quien navega con lector de pantalla.
const tituloMapa = `Mapa de la ubicación: ${site.recinto}, ${site.direccion}`;
---

<section class="sede" id="sede">
  <div class="sede__inner">
    <div class="sede__datos">
      <p class="sede__eyebrow" data-anim>Sede</p>
      <h2 class="sede__titulo" data-anim>Dónde y cuándo</h2>

      <dl class="ficha" data-anim>
        {datos.map((dato) => (
          <div class="ficha__fila" data-pendiente={dato.valor ? undefined : 'true'}>
            <dt class="ficha__etiqueta">{dato.etiqueta}</dt>
            <dd class="ficha__valor">{dato.valor ?? dato.pendiente}</dd>
          </div>
        ))}
      </dl>

      {!site.recinto && (
        <p class="sede__aviso" data-anim>
          Estamos cerrando el recinto. En cuanto se confirme, aquí aparecerá la
          dirección exacta y el mapa para llegar.
        </p>
      )}
    </div>

    <div class="sede__mapa" data-anim>
      <div class="mapa__marco">
        {/*
          `loading="lazy"`: el mapa vive bajo el pliegue y Maps arrastra bastante
          peso. Que no entre en la primera carga es lo que impide que toque el
          LCP del hero.

          El alto lo reserva `.mapa__marco` con aspect-ratio ANTES de que el
          iframe cargue, así que el CLS no se mueve de 0.
        */}
        <iframe
          class="mapa__iframe"
          src={mapaEmbed}
          title={tituloMapa}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <p class="mapa__pie">
        <a
          class="mapa__enlace"
          href={mapaComoLlegar}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="mapa__pin"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              d="M12 21.2s6.8-5.7 6.8-11a6.8 6.8 0 1 0-13.6 0c0 5.3 6.8 11 6.8 11Z"
              stroke="currentColor"
              stroke-linejoin="round"
              fill="none"
            />
            <circle cx="12" cy="10.2" r="2.6" stroke="currentColor" fill="none" />
          </svg>
          Cómo llegar
          {/* El destino abre en pestaña nueva; se anuncia para que no sorprenda. */}
          <span class="sr-only">(abre Google Maps en una pestaña nueva)</span>
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('.sede');

  import('../scripts/animations.js')
    .then(({ initMotion }) => {
      const { gsap, reduced } = initMotion();
      if (reduced || !gsap || !seccion) return;

      gsap.fromTo(
        seccion.querySelectorAll<HTMLElement>('[data-anim]'),
        { opacity: 0, y: 28 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: { trigger: seccion, start: 'top 78%', once: true },
        }
      );
    })
    .catch(() => {
      /* Sin capa de movimiento: la sección ya está en su estado final. */
    });
</script>

<style>
  .sede {
    padding-block: var(--space-3xl);
  }

  .sede__inner {
    display: grid;
    max-width: var(--container);
    gap: var(--space-2xl);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .sede__datos {
    min-width: 0;
  }

  .sede__eyebrow {
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .sede__titulo {
    margin-block-start: var(--space-sm);
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  /* Ficha de datos --------------------------------------------------------- */
  .ficha {
    margin-block-start: var(--space-xl);
  }

  .ficha__fila {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-md);
    border-block-start: 1px solid var(--border);
  }

  .ficha__fila:last-child {
    border-block-end: 1px solid var(--border);
  }

  .ficha__etiqueta {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ficha__valor {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /*
    Dato pendiente: se apaga, no se esconde. Que se lea distinto del resto es
    justo el objetivo — comunica "falta este dato", no "aquí no hay nada".
  */
  .ficha__fila[data-pendiente] .ficha__valor {
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 500;
    font-style: italic;
  }

  .sede__aviso {
    max-width: 46ch;
    margin-block-start: var(--space-lg);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  /* Mapa ------------------------------------------------------------------- */
  .sede__mapa {
    min-width: 0;
  }

  /*
    El marco RESERVA la caja antes de que el iframe cargue. Como el mapa va en
    lazy, sin esta reserva el hueco valdría 0 hasta que Maps respondiera y la
    página daría un tirón justo al llegar scrolleando. Con aspect-ratio aquí,
    el CLS se queda en 0.
  */
  .mapa__marco {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--surface);
  }

  .mapa__iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .mapa__pie {
    margin-block-start: var(--space-md);
  }

  .mapa__enlace {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 600;
    /* El subrayado nace del borde y no de text-decoration para poder separarlo
       del texto y animarlo sin que salte la línea base. */
    border-block-end: 1px solid var(--border);
    padding-block-end: 2px;
    transition:
      border-color var(--t-base) var(--ease-out),
      color var(--t-base) var(--ease-out);
  }

  .mapa__enlace:hover {
    color: var(--accent);
    border-block-end-color: var(--accent);
  }

  .mapa__pin {
    flex: none;
    color: var(--accent);
  }

  /* Desktop: datos a la izquierda, mapa a la derecha. En móvil el orden del
     DOM ya es el correcto y se apilan. */
  @media (min-width: 62rem) {
    .sede__inner {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>
