---
/*
  Los tres ejes temáticos del congreso. Es la sección que traduce «de qué va
  esto» antes de que el usuario entre al programa detallado.

  El número (01, 02, 03) es puramente gráfico: va detrás del texto, a opacidad
  baja y marcado aria-hidden, porque no aporta nada a quien escucha la página.
*/
const pilares = [
  {
    numero: '01',
    titulo: 'Productividad medible',
    texto:
      'Manejo, nutrición, ambiente y registros que se traducen en indicadores reales de granja, no en teoría.',
  },
  {
    numero: '02',
    titulo: 'Sanidad preventiva',
    texto:
      'Diagnóstico temprano, bioseguridad y vacunación para proteger la producción antes de perder dinero.',
  },
  {
    numero: '03',
    titulo: 'Tecnología aplicada',
    texto:
      'Herramientas digitales e inteligencia artificial para producir, vender y decidir mejor.',
  },
];
---

<section class="pilares" id="pilares">
  <div class="pilares__inner">
    <h2 class="pilares__titulo" data-anim>Tres frentes, un mismo resultado</h2>

    <ul class="pilares__lista" role="list">
      {pilares.map((pilar) => (
        <li class="pilar" data-anim>
          <span class="pilar__numero" aria-hidden="true">{pilar.numero}</span>
          <h3 class="pilar__titulo">{pilar.titulo}</h3>
          <p class="pilar__texto">{pilar.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('.pilares');

  // Import dinámico, igual que en Nav, Hero y VideoSection: la capa de
  // movimiento es mejora progresiva y no puede tumbar nada esencial.
  import('../scripts/animations.js')
    .then(({ initMotion }) => {
      const { gsap, reduced } = initMotion();
      if (reduced || !gsap || !seccion) return;

      const elementos = seccion.querySelectorAll<HTMLElement>('[data-anim]');

      gsap.fromTo(
        elementos,
        { opacity: 0, y: 28 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: seccion,
            start: 'top 78%',
            once: true,
          },
        }
      );
    })
    .catch(() => {
      /* Sin capa de movimiento: la sección ya está en su estado final. */
    });
</script>

<style>
  .pilares {
    padding-block: var(--space-3xl);
  }

  .pilares__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .pilares__titulo {
    max-width: 20ch;
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .pilares__lista {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-2xl);
  }

  /* Cada pilar es su propio contexto de apilamiento para que el número quede
     detrás del texto sin necesidad de z-index en los hijos. */
  .pilar {
    position: relative;
    isolation: isolate;

    /*
      TARJETA, no un bloque suelto bajo una raya. Antes solo había un
      border-block-start y la sección se leía como tres párrafos en fila.
      La elevación es --surface sobre el --bg de la sección: un escalón, no
      un salto, que es lo que pide la sobriedad del sitio.
    */
    /*
      El padding superior es GRANDE a propósito: es la banda donde vive el
      numeral. Con el padding normal el contorno cruzaba el título — con el
      relleno al 7% de antes no se notaba porque no se veía nada, pero en
      contorno visible es ruido justo encima del texto. Se vio en captura.
    */
    padding: var(--space-2xl) var(--space-lg) var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--surface);
    /* clip para que el filo de acento respete el radio de las esquinas. */
    overflow: clip;
    transition:
      transform var(--t-base) var(--ease-out),
      border-color var(--t-base) var(--ease-out),
      box-shadow var(--t-base) var(--ease-out);
  }

  /*
    EL FILO SUPERIOR ES UN DEGRADADO QUE SE APAGA, no un borde plano.
    Arranca en --accent sobre el canto izquierdo —donde está el número— y se
    disuelve antes del otro extremo: marca el inicio de la tarjeta sin
    encerrarla en una caja.
  */
  .pilar::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 2px;
    background-image: linear-gradient(
      to right,
      var(--accent),
      color-mix(in srgb, var(--accent) 35%, transparent) 45%,
      transparent 85%
    );
  }

  .pilar:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow-md);
  }

  .pilar__numero {
    position: absolute;
    z-index: -1;
    inset-block-start: -0.22em;
    inset-inline-start: -0.03em;
    font-family: var(--font-display);
    /*
      --step-4, no --step-5. A step-5 (104px medidos) el numeral no cabía en
      su banda y se metía en el título. Este tamaño sigue siendo mayor que el
      original en presencia —lo que cambió de verdad es el contorno, no los
      píxeles— y deja el texto limpio.
    */
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    user-select: none;

    /*
      RESPALDO: relleno tenue. Es lo que se ve si el navegador no soporta el
      contorno, y es el mismo tratamiento que había antes, así que el peor
      caso es «como estaba» y no «un número invisible».
    */
    color: var(--accent);
    opacity: 0.1;
  }

  /*
    CIFRA DE CONTORNO. Relleno transparente y trazo fino en --accent: el
    número gana presencia sin ganar peso, que era justo el problema —a
    opacidad 0.07 y relleno sólido no se veía—.

    Va en @supports porque -webkit-text-stroke no es estándar: donde no
    exista manda el bloque de arriba.
  */
  @supports (-webkit-text-stroke: 1px currentColor) {
    .pilar__numero {
      color: transparent;
      -webkit-text-stroke: 1.25px var(--accent);
      opacity: 0.34;
    }
  }

  .pilar__titulo {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .pilar__texto {
    max-width: 42ch;
    margin-block-start: var(--space-sm);
    color: var(--text-muted);
  }

  /*
    SIN MOVIMIENTO: la tarjeta no se levanta. El corte global neutraliza las
    duraciones, pero transform es geometría, no tiempo, y con el puntero
    encima se quedaría desplazada de golpe. El hover sigue informando con
    color y sombra, que no mueven nada.
  */
  @media (prefers-reduced-motion: reduce) {
    .pilar,
    .pilar:hover {
      transform: none;
      transition: none;
    }
  }

  /* Desktop: tres columnas. Por debajo se apilan en el orden natural del DOM. */
  @media (min-width: 62rem) {
    .pilares__lista {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
