---
import patrocinadores from '../data/patrocinadores.json';
import { asset } from '../scripts/paths.js';
import { waUrl } from '../scripts/contacto.js';

/*
  Patrocinadores — tarjetas con ficha completa en modal.

  TODO sale de src/data/patrocinadores.json. Aquí no hay ni un teléfono, ni un
  correo, ni una dirección escritos a mano.

  ── LA FICHA NO VIVE SOLO EN EL MODAL ────────────────────────────────────────

  Mismo reparto que Ponentes, y por la misma razón: cada ficha se emite como un
  <dialog> CON el atributo `open`. Un <dialog open> no es modal, se pinta como
  un bloque en el flujo, así que SIN JavaScript la página enseña la rejilla y
  debajo las seis fichas completas, y `#patrocinador-{slug}` es un ancla a un
  elemento que existe de verdad. Con JavaScript el script los cierra al arrancar
  y a partir de ahí usa `showModal()`, que da gratis el foco atrapado, Escape,
  `aria-modal`, el fondo inerte y el retorno de foco al elemento que abrió.

  ── LOS CAMPOS NULL NO SE RENDERIZAN ─────────────────────────────────────────

  Ninguno se pinta como «no disponible». Todo lo que puede faltar se resuelve
  AQUÍ, en el frontmatter, y la plantilla solo lee valores ya listos — mismo
  patrón que `entradas` en Boletos.astro y `items` en Faq.astro. Así el JSX no
  se llena de ternarios y no hay forma de que un null se escape al HTML.

  ── DOS CAMPOS QUE NO ESTABAN EN EL ENCARGO Y POR QUÉ ────────────────────────

  `whatsapp`  — no todos los teléfonos son WhatsApp y NO hay manera de saber
                cuál lo es mirando el número. El único con evidencia es el de
                Victoria Linares: su propio logotipo lleva el icono de WhatsApp
                junto a «Pedidos: 2381332647». Poner el botón en los demás sería
                prometer un canal que quizá no existe, que es justo lo que este
                proyecto lleva evitando desde el aviso de Boletos.
  `fondoOscuro` — ver el bloque del chip oscuro en el CSS.
*/

/*
  Los tipos van en TypeScript y NO en JSDoc: esto es el frontmatter de un
  .astro, no un .js de src/scripts/. Con `@param {string}` el check da ts(7006)
  por parámetro más un ts(80004). Ya documentado al construir /agenda.
*/

/** Dígitos limpios para `tel:`. El JSON los guarda agrupados para leerlos. */
const soloDigitos = (t: unknown) => String(t ?? '').replace(/\D/g, '');

/**
 * Un valor de red social puede venir como URL COMPLETA o como nombre de página.
 *
 * Avipork trae «AVIPORK» y Victoria Linares «Avicola Victoria Linares»: son
 * nombres, no URLs, y el segundo ni siquiera es un identificador válido. Salvo
 * que ya sea una URL, se pinta como TEXTO y no como enlace: componer
 * `facebook.com/{nombre}` a ojo es fabricar un enlace que puede dar 404, el
 * mismo error que se evitó con /privacidad y con las anclas muertas.
 */
function red(valor: string | null) {
  if (!valor) return null;
  const v = String(valor).trim();
  if (!/^https?:\/\//i.test(v)) return { href: null, texto: v };
  try {
    const url = new URL(v);
    const tramos = url.pathname.split('/').filter(Boolean);
    return {
      href: v,
      texto: tramos.length ? tramos[tramos.length - 1] : url.hostname.replace(/^www\./, ''),
    };
  } catch {
    return { href: null, texto: v };
  }
}

/** La web se etiqueta con su dominio, que es lo que la gente reconoce. */
function web(valor: string | null) {
  if (!valor) return null;
  try {
    return { href: valor, texto: new URL(valor).hostname.replace(/^www\./, '') };
  } catch {
    return { href: valor, texto: valor };
  }
}

const fichas = patrocinadores.map((p) => {
  const digitosWa = soloDigitos(p.whatsapp);

  return {
    ...p,
    logoSrc: asset(p.logo),
    telefonos: (p.telefonos ?? []).map((t) => ({
      legible: t,
      tel: `+52${soloDigitos(t)}`,
      /*
        El botón de WhatsApp solo aparece en el teléfono que ADEMÁS está
        declarado como tal. Se compara por dígitos y no por cadena para que
        un agrupado distinto en los dos campos no lo desactive en silencio.
      */
      wa:
        digitosWa && soloDigitos(t) === digitosWa
          ? waUrl(t, `Hola, los vi en la Expo Avícola Productiva 2026`)
          : null,
    })),
    web: web(p.web),
    facebook: red(p.facebook),
    instagram: red(p.instagram),
  };
});
---

<section class="patros" id="patrocinadores" {...Astro.props}>
  <div class="patros__inner">
    <header class="patros__head">
      <p class="patros__eyebrow" data-anim>Patrocinadores</p>
      <h2 class="patros__titulo" data-anim>Quienes hacen posible el congreso</h2>
    </header>

    <ul class="patros__lista" role="list">
      {
        fichas.map((p) => (
          <li class="patro" data-anim>
            <article
              class="patro__marco"
              data-fondo-propio={p.fondoPropio ? '' : undefined}
              data-fondo-oscuro={p.fondoOscuro ? '' : undefined}
            >
              <div class="patro__caja" data-logo-frame>
                <img
                  class="patro__logo"
                  src={p.logoSrc}
                  alt={`Logotipo de ${p.nombre}`}
                  width="200"
                  height="200"
                  loading="lazy"
                  decoding="async"
                  data-logo-img
                />
                <span class="patro__respaldo" aria-hidden="true">
                  {p.nombre}
                </span>
              </div>

              <p class="patro__desc">
                <a class="patro__enlace" href={`#patrocinador-${p.slug}`}>
                  <span class="sr-only">{p.nombre}: </span>
                  {p.descripcionCorta}
                </a>
              </p>

              <p class="patro__mas" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                  <circle
                    cx="12"
                    cy="12"
                    r="9"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                  />
                  <path
                    d="M12 8.5v7M8.5 12h7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linecap="round"
                  />
                </svg>
                <span>Ver ficha</span>
              </p>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="patros__invita" data-anim>
      ¿Tu empresa trabaja en nutrición, sanidad, genética, equipos o tecnología
      avícola? Hay espacios de expositor disponibles en el área comercial.
    </p>
  </div>

  {/*
    LAS FICHAS. `open` es deliberado — ver el frontmatter.

    Van fuera de .patros__inner porque al pasar a modal se despegan del flujo y
    no deben heredar el ancho del contenedor.

    `data-ficha-patro` y NO `data-ficha`: ese lo usa Ponentes.astro para su
    propio script, y el script del cliente no está acotado por Astro. Si los dos
    compartieran marcador, el `desdeHash` de Ponentes cerraría estas fichas en
    cuanto el hash no empezara por `ponente-`, y este cerraría las suyas.

    `data-ficha-modal` y `data-ficha-seccion` SÍ son comunes a las dos familias:
    los lee `bindAnchors()` de animations.js para no desplazar el scroll hacia un
    elemento de la capa superior —cuyo offsetTop resuelve a ~0— y para saber a
    qué sección llevar a quien llegue con el enlace compartido.

    OJO con los comentarios: un {…} suelto dentro del cuerpo con paréntesis de un
    .map() son DOS expresiones y el compilador de Astro lo rechaza con un error
    que no menciona los comentarios. Van todos en este bloque, fuera del map.
  */}
  <div class="pfichas">
    {
      fichas.map((p) => (
        <dialog
          class="pficha"
          data-ficha-patro
          data-ficha-modal
          data-ficha-seccion="#patrocinadores"
          id={`patrocinador-${p.slug}`}
          open
          aria-labelledby={`pficha-titulo-${p.slug}`}
        >
          <article class="pficha__caja">
            <form method="dialog" class="pficha__cerrar-form">
              <button class="pficha__cerrar" type="submit" aria-label="Cerrar ficha">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                  <path
                    d="m6 6 12 12M18 6 6 18"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    fill="none"
                  />
                </svg>
              </button>
            </form>

            <header class="pficha__cabecera">
              <div
                class="pficha__marco"
                data-fondo-propio={p.fondoPropio ? '' : undefined}
                data-fondo-oscuro={p.fondoOscuro ? '' : undefined}
              >
                <img
                  class="pficha__logo"
                  src={p.logoSrc}
                  alt={`Logotipo de ${p.nombre}`}
                  width="200"
                  height="200"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="pficha__identidad">
                <h3 class="pficha__nombre" id={`pficha-titulo-${p.slug}`}>
                  {p.nombre}
                </h3>
                {p.razonSocial && <p class="pficha__razon">{p.razonSocial}</p>}
              </div>
            </header>

            <p class="pficha__desc">{p.descripcionLarga}</p>

            {(p.ubicacion || p.contacto) && (
              <dl class="datos">
                {p.ubicacion && (
                  <div class="datos__fila">
                    <dt class="datos__clave">Ubicación</dt>
                    <dd class="datos__valor">{p.ubicacion}</dd>
                  </div>
                )}
                {p.contacto && (
                  <div class="datos__fila">
                    <dt class="datos__clave">Contacto</dt>
                    <dd class="datos__valor">{p.contacto}</dd>
                  </div>
                )}
              </dl>
            )}

            {p.telefonos.length > 0 && (
              <section class="pbloque">
                <h4 class="pbloque__titulo">
                  {p.telefonos.length > 1 ? 'Teléfonos' : 'Teléfono'}
                </h4>
                <ul class="tels" role="list">
                  {p.telefonos.map((t) => (
                    <li class="tels__fila">
                      <a class="tels__num" href={`tel:${t.tel}`}>
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <path
                            d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linejoin="round"
                          />
                        </svg>
                        {t.legible}
                      </a>
                      {t.wa && (
                        <a
                          class="tels__wa"
                          href={t.wa}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                            <path
                              d="M20.5 11.6a8.5 8.5 0 0 1-12.7 7.4L3.5 20.5l1.6-4.2A8.5 8.5 0 1 1 20.5 11.6Z"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linejoin="round"
                            />
                            <path
                              d="M9 8.6c.3-.1.7 0 .9.4l.6 1.2c.1.3 0 .6-.2.8l-.4.4a5.2 5.2 0 0 0 2.7 2.7l.4-.4c.2-.2.5-.3.8-.2l1.2.6c.4.2.5.6.4.9-.2.7-.9 1.2-1.7 1.1a7.5 7.5 0 0 1-5.8-5.8c-.1-.8.4-1.5 1.1-1.7Z"
                              fill="currentColor"
                            />
                          </svg>
                          WhatsApp
                          <span class="sr-only">
                            {' '}
                            de {p.nombre}, abre en una pestaña nueva
                          </span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {p.correo && (
              <section class="pbloque">
                <h4 class="pbloque__titulo">Correo</h4>
                <a class="pficha__correo" href={`mailto:${p.correo}`}>
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <rect
                      x="3"
                      y="5"
                      width="18"
                      height="14"
                      rx="2"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />
                    <path
                      d="m3.6 6.5 8.4 6 8.4-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                    />
                  </svg>
                  {p.correo}
                </a>
              </section>
            )}

            {(p.web || p.facebook || p.instagram) && (
              <section class="pbloque">
                <h4 class="pbloque__titulo">En línea</h4>
                <ul class="redes" role="list">
                  {p.web && (
                    <li>
                      <a
                        class="red red--enlace"
                        href={p.web.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <circle
                            cx="12"
                            cy="12"
                            r="8.5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                          />
                          <path
                            d="M3.5 12h17M12 3.5c4.5 4.7 4.5 12.3 0 17-4.5-4.7-4.5-12.3 0-17Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                          />
                        </svg>
                        {p.web.texto}
                        <span class="sr-only"> (abre en una pestaña nueva)</span>
                      </a>
                    </li>
                  )}

                  {p.facebook && p.facebook.href && (
                    <li>
                      <a
                        class="red red--enlace"
                        href={p.facebook.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <path
                            d="M14.5 8.5h2.2V5.6h-2.4c-2.2 0-3.6 1.4-3.6 3.7v1.6H8.4v3h2.3v7h3v-7h2.3l.4-3h-2.7V9.6c0-.7.3-1.1.8-1.1Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linejoin="round"
                          />
                        </svg>
                        Facebook
                        <span class="sr-only"> (abre en una pestaña nueva)</span>
                      </a>
                    </li>
                  )}

                  {p.facebook && !p.facebook.href && (
                    <li>
                      <span class="red">
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <path
                            d="M14.5 8.5h2.2V5.6h-2.4c-2.2 0-3.6 1.4-3.6 3.7v1.6H8.4v3h2.3v7h3v-7h2.3l.4-3h-2.7V9.6c0-.7.3-1.1.8-1.1Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linejoin="round"
                          />
                        </svg>
                        Facebook: {p.facebook.texto}
                      </span>
                    </li>
                  )}

                  {p.instagram && p.instagram.href && (
                    <li>
                      <a
                        class="red red--enlace"
                        href={p.instagram.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <rect
                            x="3.5"
                            y="3.5"
                            width="17"
                            height="17"
                            rx="5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                          />
                          <circle
                            cx="12"
                            cy="12"
                            r="4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                          />
                          <circle cx="17" cy="7" r="1.1" fill="currentColor" />
                        </svg>
                        Instagram
                        <span class="sr-only"> (abre en una pestaña nueva)</span>
                      </a>
                    </li>
                  )}

                  {p.instagram && !p.instagram.href && (
                    <li>
                      <span class="red">
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <rect
                            x="3.5"
                            y="3.5"
                            width="17"
                            height="17"
                            rx="5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                          />
                          <circle
                            cx="12"
                            cy="12"
                            r="4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                          />
                          <circle cx="17" cy="7" r="1.1" fill="currentColor" />
                        </svg>
                        Instagram: {p.instagram.texto}
                      </span>
                    </li>
                  )}
                </ul>
              </section>
            )}
          </article>
        </dialog>
      ))
    }
  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('.patros');

  // -----------------------------------------------------------------------
  // Logos: nunca debe verse un icono de imagen rota. Sin GSAP de por medio.
  // -----------------------------------------------------------------------
  (() => {
    const marcos = document.querySelectorAll<HTMLElement>('.patros [data-logo-frame]');

    marcos.forEach((marco) => {
      const img = marco.querySelector<HTMLImageElement>('[data-logo-img]');
      if (!img) return;

      const cargada = () => (marco.dataset.state = 'loaded');
      const fallida = () => (marco.dataset.state = 'failed');

      if (img.complete) {
        // Ya resuelta antes de que corriera este script.
        if (img.naturalWidth > 0) cargada();
        else fallida();
      } else {
        img.addEventListener('load', cargada, { once: true });
        img.addEventListener('error', fallida, { once: true });
      }
    });
  })();

  // -----------------------------------------------------------------------
  // Fichas en modal. Mismo mecanismo que Ponentes.astro, y por las mismas
  // razones: ver los comentarios del marcado y del CSS.
  // -----------------------------------------------------------------------
  const fichas = Array.from(
    document.querySelectorAll<HTMLDialogElement>('dialog[data-ficha-patro]')
  );

  /*
    Quitarles el `open`. Hasta aquí se pintaban como bloques —que es lo que ve
    quien no tiene JS—; con JS pasan a ser modales. Se hace en cuanto corre el
    script, no en 'load', para que no se vea el bloque un instante.
  */
  for (const f of fichas) f.close();

  const porId = new Map(fichas.map((f) => [f.id, f]));

  /**
   * Abre la ficha de un id, si existe y no está ya abierta.
   *
   * `showModal()` da foco atrapado, Escape, aria-modal, fondo inerte y retorno
   * de foco al abridor. No hay que implementar nada de eso a mano.
   */
  const abrir = (id: string) => {
    const f = porId.get(id);
    if (!f || f.open) return;

    /*
      CERRAR LA QUE HUBIERA ABIERTA ANTES DE ABRIR LA NUEVA. Los <dialog>
      modales se APILAN: con una abierta, showModal() pone la segunda encima y
      al cerrarla reaparece la primera. Pasa al llegar a otro hash por
      hashchange. Es el mismo fallo que se cazó en Ponentes MIRANDO una captura.
    */
    for (const otra of fichas) if (otra !== f && otra.open) otra.close();

    f.showModal();
  };

  /*
    Los enlaces. Se escucha en el documento entero: un solo listener cubre las
    seis tarjetas y cualquier enlace a una ficha que se añada después.
  */
  document.addEventListener('click', (ev) => {
    const el = ev.target as HTMLElement | null;
    const a = el?.closest<HTMLAnchorElement>('a[href*="#patrocinador-"]');
    if (!a) return;

    // Solo clic primario y sin modificadores: Ctrl/Cmd+clic debe abrir pestaña.
    const me = ev as MouseEvent;
    if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;

    const id = a.hash.slice(1);
    if (!porId.has(id)) return;

    ev.preventDefault();
    /*
      El hash SÍ se escribe, para que la ficha sea compartible por WhatsApp, que
      es el canal del evento. `pushState` en vez de asignar location.hash para no
      provocar un salto de scroll: el modal ya está a la vista.
    */
    history.pushState(null, '', a.hash);
    abrir(id);
  });

  for (const f of fichas) {
    /*
      Al cerrar, limpiar el hash. Si se queda, recargar o volver con «Atrás»
      reabriría la ficha sin que nadie lo haya pedido.
    */
    f.addEventListener('close', () => {
      if (location.hash === `#${f.id}`) {
        history.replaceState(null, '', location.pathname + location.search);
      }
    });

    /*
      Clic en el fondo cierra. <dialog> no lo hace solo: el evento llega al
      propio <dialog>, cuya caja ocupa toda la ventana, así que se compara con la
      caja REAL del contenido.
    */
    f.addEventListener('click', (ev) => {
      if (ev.target !== f) return;
      const caja = f.querySelector('.pficha__caja');
      if (!caja) return;
      const r = caja.getBoundingClientRect();
      const dentro =
        ev.clientX >= r.left &&
        ev.clientX <= r.right &&
        ev.clientY >= r.top &&
        ev.clientY <= r.bottom;
      if (!dentro) f.close();
    });
  }

  /**
   * Lleva la vista a la SECCIÓN de patrocinadores.
   *
   * ES EL ÚNICO CAMINO EN QUE EL SCROLL SE MUEVE, y solo en la llegada directa
   * con hash: quien abre un enlace compartido merece ver el contexto detrás del
   * modal. Pulsando desde dentro de la página no se mueve nada.
   *
   * Va a la sección y NO a la ficha: con `showModal()` la ficha está en la capa
   * superior, donde se posiciona contra el viewport y su offsetTop resuelve a
   * ~0, así que «desplazarse hasta ella» es irse al principio de la página.
   */
  const llevarALaSeccion = () => {
    if (!seccion) return;
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const y =
      seccion.getBoundingClientRect().top + window.scrollY - (nav ? nav.offsetHeight : 0);
    window.scrollTo({ top: Math.max(0, y), behavior: 'instant' });
  };

  const desdeHash = (inicial = false) => {
    const id = location.hash.slice(1);

    if (id.startsWith('patrocinador-') && porId.has(id)) {
      abrir(id);
      if (inicial) requestAnimationFrame(llevarALaSeccion);
      return;
    }

    /*
      El hash ya no apunta a ninguna ficha DE ESTA SECCIÓN. Solo se cierran las
      propias: `fichas` sale de [data-ficha-patro], así que las de Ponentes no
      están en esta lista y este bucle no las toca.
    */
    for (const f of fichas) if (f.open) f.close();
  };

  desdeHash(true);
  window.addEventListener('hashchange', () => desdeHash());

  // -----------------------------------------------------------------------
  // Movimiento: mejora progresiva.
  // -----------------------------------------------------------------------
  import('../scripts/animations.js')
    .then(({ initMotion }) => {
      const { gsap, reduced } = initMotion();
      if (reduced || !gsap || !seccion) return;

      gsap.fromTo(
        seccion.querySelectorAll<HTMLElement>('[data-anim]'),
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: { trigger: seccion, start: 'top 80%', once: true },
        }
      );
    })
    .catch(() => {
      /* Sin capa de movimiento: la sección ya está en su estado final. */
    });
</script>

<style>
