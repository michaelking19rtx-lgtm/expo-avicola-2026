  :global([data-js]) .figura__marco[data-state='loaded'] .figura__img {
    opacity: 1;
  }

  :global([data-js]) .figura__marco[data-state='loaded'] .figura__placeholder {
    display: none;
  }

  :global([data-js]) .figura__marco[data-state='failed'] .figura__img {
