    font-size: clamp(2.5rem, -0.75rem + 7.5vw, 5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero__line {
    display: block;
  }

  .hero__line--acento {
    color: var(--accent);
  }

  .hero__tagline {
