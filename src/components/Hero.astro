---
import site from '../data/site.json';
import ponentesHero from '../data/hero-ponentes.json';
import { asset } from '../scripts/paths.js';

/*
  El título se parte a mano en líneas en vez de dejar que el navegador decida:
  el ritmo de las cuatro líneas es parte del diseño, y la animación de entrada
  las revela una por una. Una línea va en --accent para romper el bloque.
*/
const lineasTitulo = [
  { texto: 'Innovación y', acento: false },
  { texto: 'productividad', acento: true },
  { texto: 'para el sector', acento: false },
  { texto: 'avícola', acento: false },
];

// El tagline vive en site.json: es dato del evento, no copy del componente.
const tagline = site.tagline;

/*
  Valores iniciales de la cuenta regresiva calculados en build.

  Se pintan ya resueltos —en vez de ceros— para que no haya destello ni salto
  de layout: el script los corrige en el primer tick. Como el sitio se
  redespliega en cada push, en producción arrancan prácticamente al día.
*/
const restanteMs = Math.max(0, new Date(site.inicio).getTime() - Date.now());
const totalSegundos = Math.floor(restanteMs / 1000);
const dosDigitos = (n: number) => String(n).padStart(2, '0');

const unidades = [
  { clave: 'dias', etiqueta: 'Días', valor: dosDigitos(Math.floor(totalSegundos / 86400)) },
  { clave: 'horas', etiqueta: 'Horas', valor: dosDigitos(Math.floor((totalSegundos % 86400) / 3600)) },
  { clave: 'min', etiqueta: 'Min', valor: dosDigitos(Math.floor((totalSegundos % 3600) / 60)) },
  { clave: 'seg', etiqueta: 'Seg', valor: dosDigitos(totalSegundos % 60) },
];

/* ===========================================================================
   COMPOSICIÓN DE PONENTES — DOS RANGOS DE PROFUNDIDAD

   Todo se DERIVA de hero-ponentes.json: número de figuras, reparto por filas,
   posición, escala, opacidad, elevación, z-index, orden de entrada y
   duraciones de flotación. No hay ni un valor colocado a mano.

   - Con 3 figuras o menos → UNA fila.
   - Con más de 3          → DOS rangos: frontal (escala 1, línea base abajo)
                             y fondo (más pequeño, más apagado y con la línea
                             base ELEVADA, encajado en los huecos de la fila
                             frontal para que las caras asomen entre hombros).

   Por qué dos rangos y no una fila de seis: en una sola fila la huella
   horizontal serían 3.5 anchos de figura y, como el tamaño está limitado por
   el ancho disponible, cada figura ENCOGERÍA. Con dos rangos la huella la
   marca la fila frontal (~2.16 anchos) y la figura crece.
   ======================================================================== */

const n = ponentesHero.length;

/*
  El reparto por filas sale del número de figuras, nunca de una lista escrita.

  La fila frontal se fuerza a cardinalidad IMPAR cuando hay dos rangos, y no
  es cosmético: `centrar()` coloca al destacado en Math.floor((total−1)/2), que
  en una fila PAR no es el centro sino la posición de la izquierda. Con n=4
  eso dejaba al destacado en el borde izquierdo de toda la composición, con el
  mismo z-index que su vecina —que además le pintaba encima— y entrando el
  tercero en la animación en vez del primero. Con la fila impar existe un
  centro de verdad y los tres síntomas desaparecen de raíz.

      n=4 → 3 frontales + 1 de fondo      n=7 → 5 + 2
      n=5 → 3 + 2                         n=8 → 5 + 3
      n=6 → 3 + 3  (sin cambio)
*/
const DOS_RANGOS = n > 3;
const mitad = Math.ceil(n / 2);
const nFrente = DOS_RANGOS ? (mitad % 2 === 0 ? mitad + 1 : mitad) : n;

/*
  ORDEN DEL JSON = REPARTO. El destacado va al centro de la fila frontal; de
  los demás, los primeros del array completan la fila FRONTAL y el resto pasa
  al FONDO. Es deliberado que lo mande el orden del array: así el reparto se
  cura desde los datos (ver «regla de recorte» en CLAUDE.md) sin tocar código.
*/
const destacado = ponentesHero.find((p) => p.destacado) ?? ponentesHero[0];
const resto = ponentesHero.filter((p) => p !== destacado);
const frenteResto = resto.slice(0, nFrente - 1);
const fondoLista = resto.slice(nFrente - 1);

/*
  Coloca al destacado en el centro y reparte el resto alternando hacia afuera.
  Se hace en build y NO con `order` de CSS: así el orden del DOM puede seguir
  siendo el orden visual, que es el único orden de tabulación con sentido.
*/
function centrar<T>(dest: T, otros: T[], total: number): T[] {
  const pos: T[] = new Array(total);
  const c = Math.floor((total - 1) / 2);
  pos[c] = dest;
  let izq = c - 1;
  let der = c + 1;
  let haciaIzquierda = true;
  for (const p of otros) {
    if (haciaIzquierda && izq >= 0) pos[izq--] = p;
    else if (der < total) pos[der++] = p;
    else pos[izq--] = p;
    haciaIzquierda = !haciaIzquierda;
  }
  return pos;
}

const frente = centrar(destacado, frenteResto, nFrente);
const fondo = fondoLista;
const nFondo = fondo.length;

/* ---------------------------------------------------------------------------
   GEOMETRÍA. Las unidades son ANCHOS DE FIGURA (x) y ALTOS DE FIGURA (y), así
   que todo lo de abajo es adimensional y el tamaño real lo decide el CSS.
   ------------------------------------------------------------------------ */

/*
  PASO entre figuras vecinas de la misma fila, en anchos de figura.

  0.5 = los lienzos solapan un 50%, que es lo que hace que los CUERPOS solapen
  un ~19%. Medido sobre los seis recortes, la silueta ocupa entre el 50.7% y el
  62.4% del ancho del lienzo; con el 62% de las tres frontales:

      solape_cuerpo = (0.62 − 0.5) / 0.62 = 0.194

  El resto del lienzo es margen transparente, y por eso un solape de lienzo
  del 20% —lo primero que se probó— dejaba los cuerpos SIN tocarse: el hero se
  leía como seis recortes en fila en vez de como una composición.
*/
const PASO = 0.5;

// Fila de fondo: más pequeña, más apagada y con la línea base elevada.
const ESC_FONDO = 0.82;
const OPA_FONDO = 0.78;
const ELEV_FONDO = 0.186; // en altos de figura

/*
  La fila de fondo va desplazada MEDIO PASO respecto a la frontal: es lo que
  la mete en los huecos y deja que las caras asomen entre hombro y hombro.
  Con un número impar de figuras por fila no existe reparto simétrico —
  centrarlas pondría una justo detrás del destacado, tapándola—, así que el
  desplazamiento es siempre hacia el mismo lado y el conjunto se equilibra
  centrando su caja completa.
*/
const DESFASE_FONDO = 0.5;

const proporcion = 56 / 75; // ancho/alto del lienzo, 0.746667

const anchoFrente = (nFrente - 1) * PASO + 1;
const anchoFondo = nFondo
  ? (nFondo - 1 + DESFASE_FONDO) * PASO + (1 + ESC_FONDO) / 2
  : 0;
const wTotal = +Math.max(anchoFrente, anchoFondo).toFixed(4);
const hTotal = +(nFondo ? Math.max(1, ELEV_FONDO + ESC_FONDO) : 1).toFixed(4);

// Proporción de la caja del conjunto. De aquí sale su alto a partir del ancho.
const razonConjunto = +((wTotal * proporcion) / hTotal).toFixed(4);

/*
  Ancho del conjunto por unidad de ALTO DE FIGURA. Es lo que permite
  dimensionar POR ALTO: se fija el alto de figura deseado y de aquí sale el
  ancho que hace falta, que luego el CSS topa con `min(100%, …)`.
*/
const anchoPorAltoFigura = +(wTotal * proporcion).toFixed(4);

const centroConjunto = wTotal / 2;

type Figura = (typeof ponentesHero)[number];
const enFila = (lista: Figura[], fila: 'frente' | 'fondo') =>
  lista.map((p, i) => {
    const x = fila === 'frente' ? i * PASO : (i + DESFASE_FONDO) * PASO;
    const esFondo = fila === 'fondo';
    // Distancia al centro de SU fila, normalizada: manda escala fina y z.
    const medio = (lista.length - 1) / 2;
    const dist = medio === 0 ? 0 : Math.abs(i - medio) / medio;
    return {
      p,
      fila,
      x: +x.toFixed(4),
      centro: +(x + 0.5).toFixed(4),
      esc: esFondo ? ESC_FONDO : 1,
      opa: esFondo ? OPA_FONDO : 1,
      elev: esFondo ? ELEV_FONDO : 0,
      /*
        z-index calculado, nunca a mano: toda la fila frontal por delante de
        todo el fondo, y dentro de cada fila el centro por delante. Que la
        fila mande sobre la distancia es lo que impide que una figura de
        fondo se cuele delante de una frontal al activarse.
      */
      z: (esFondo ? 10 : 100) - Math.round(dist * 5),
      dist,
    };
  });

/*
  Orden del DOM = orden VISUAL de izquierda a derecha, mezclando las dos filas.
  Es el único orden de tabulación que no hace saltar el foco por la pantalla.
  El apilado lo resuelve z-index, no el orden del marcado.
*/
const ordenVisual = [...enFila(frente, 'frente'), ...enFila(fondo, 'fondo')].sort(
  (a, b) => a.centro - b.centro
);

/*
  ZONA SENSIBLE al puntero, y por qué no vale la caja de la figura.

  Los lienzos solapan un 50% y además traen ~38% de margen transparente. Con
  la caja entera como área sensible, la figura con más z-index se queda el
  puntero sobre el margen VACÍO que le tapa a la vecina: medido, de seis
  figuras solo respondían dos, y al pasar el ratón por encima de una se
  encendía otra.

  El conjunto se reparte en bandas verticales: cada figura manda desde el
  punto medio con su vecina de la izquierda hasta el punto medio con la de la
  derecha, y las de los extremos se estiran hasta el borde. Es una partición
  completa —sin huecos ni solapes— así que cada punto del conjunto pertenece
  siempre a una figura y solo a una, sin depender del z-index.
*/
/*
  El orden de entrada se mide contra la DESTACADA, no contra el centro
  geométrico de la caja. La diferencia importa: la fila de fondo va desplazada
  medio paso, así que el centro de la caja no coincide con ninguna figura y en
  varias configuraciones caía más cerca de una de fondo. El reveal arrancaba
  entonces por una figura encogida y apagada, contradiciendo la premisa del
  escalonado, que es «primero la protagonista y desde ella hacia afuera».
*/
const centroDestacada =
  ordenVisual.find((f) => f.p.destacado)?.centro ?? centroConjunto;

const figuras = ordenVisual.map((f, i) => {
  const prev = ordenVisual[i - 1];
  const sig = ordenVisual[i + 1];
  const bordeIzq = prev ? (prev.centro + f.centro) / 2 : 0;
  const bordeDer = sig ? (f.centro + sig.centro) / 2 : wTotal;
  return {
    ...f,
    i,
    // Coordenadas de la banda RELATIVAS a la caja de la figura, que mide
    // exactamente un ancho de lienzo.
    zonaX: +(bordeIzq - f.x).toFixed(4),
    zonaW: +(bordeDer - bordeIzq).toFixed(4),
    // Distancia a la DESTACADA: manda el orden de entrada.
    distConjunto: Math.abs(f.centro - centroDestacada),
  };
});

// Entrada escalonada del centro hacia afuera. Se calcula aquí y viaja como
// data-fig-orden para que el JS no tenga que volver a medir nada.
const ordenEntrada = new Map(
  [...figuras]
    .sort((a, b) => a.distConjunto - b.distConjunto)
    .map((f, rank) => [f.i, rank])
);

// Dimensiones reales del WebP. Con valores que no correspondan, el navegador
// reserva una caja con la proporción equivocada y reaparece el salto de layout.
const IMG_W = 672;
const IMG_H = 900;
---

<section class="hero" id="inicio">
  <div class="hero__inner">
    <div class="hero__content">
      {/*
        El eyebrow va partido en DOS PIEZAS, y no es cosmético.

        Con el texto corrido, «TEHUACÁN, PUEBLA · 7 DE AGOSTO 2026» cabía en
        una línea con la fuente de respaldo y se partía en dos al entrar Inter
        Variable, empujando el título 22px hacia abajo. Medido en 4G a 390px:
        eyebrow de 21px a 43px y CLS de 0.028, cuatrocientas veces el de
        escritorio.

        Partiéndolo por CSS el número de líneas lo decide el layout y no la
        métrica de la fuente, así que no hay reflow posible. De paso el corte
        cae donde tiene sentido —lugar arriba, fecha abajo— en vez de a mitad
        de «7 DE / AGOSTO», que es donde caía solo.
      */}
      <p class="hero__eyebrow" data-anim>
        <span class="hero__eyebrow-parte">{site.ciudad}</span>
        <span class="hero__eyebrow-sep" aria-hidden="true"> · </span>
        <span class="hero__eyebrow-parte">7 de agosto 2026</span>
      </p>

      <h1 class="hero__title">
        {lineasTitulo.map((linea) => (
          <span
            class:list={['hero__line', linea.acento && 'hero__line--acento']}
            data-anim
          >
            {linea.texto}
          </span>
        ))}
      </h1>

      <p class="hero__tagline" data-anim>{tagline}</p>

      {/*
        La cuenta regresiva es información derivada de una fecha que ya se
        anuncia arriba en texto. Se marca decorativa para no bombardear a los
        lectores de pantalla con una actualización cada segundo.
      */}
      <div class="countdown" data-anim aria-hidden="true">
        {unidades.map((unidad) => (
          <div class="countdown__unit">
            <span class="countdown__value" data-cd={unidad.clave}>{unidad.valor}</span>
            <span class="countdown__label">{unidad.etiqueta}</span>
          </div>
        ))}
      </div>

      <div class="hero__ctas" data-anim>
        <a class="btn btn--primary" href="#boletos">Comprar mi boleto</a>
        <a class="btn btn--ghost" href="#programa">Ver programa</a>
      </div>
    </div>

    <div class="hero__media" data-hero-media>
      <div class="hero__halo" aria-hidden="true"></div>

      <div class="hero__float" data-hero-float>
        <ul
          class="conjunto"
          style={`--w-total: ${wTotal}; --h-total: ${hTotal}; --razon: ${razonConjunto}; --ancho-por-alto: ${anchoPorAltoFigura}`}
          data-conjunto
        >
          {figuras.map((f) => (
            <li
              class:list={['pieza', `pieza--${f.fila}`]}
              style={`--x: ${f.x}; --esc: ${f.esc}; --opa: ${f.opa}; --elev: ${f.elev}; --z: ${f.z}; --zona-x: ${f.zonaX}; --zona-w: ${f.zonaW}`}
              data-pieza
            >
              {/*
                PENDIENTE — Fase 3 (Ponentes).
                Cuando exista la sección, esta <figure> se envuelve en:

                  <a class="figura__enlace" href={`#ponente-${f.p.slug}`}>
                    ... la <figure> tal cual ...
                  </a>

                y entonces DESAPARECE el tabindex="0" de la <figure>: el enlace
                ya aporta el foco, y dejar los dos crearía dos paradas de
                tabulación por ponente. Hoy no se enlaza porque #ponentes no
                existe y un ancla muerta es peor que ningún enlace.
              */}
              <figure class="figura" tabindex="0" data-fig-orden={ordenEntrada.get(f.i)}>
                {/*
                  Único elemento sensible al puntero de toda la figura. Ver la
                  explicación de las bandas en el frontmatter.
                */}
                <span class="figura__zona" aria-hidden="true"></span>
                <div class="figura__profundidad">
                  <div class="figura__flota" data-fig-flota>
                    <div class="figura__entrada" data-fig-entrada data-anim>
                      <div class="figura__marco" data-fig-marco>
                        {/*
                          PRIORIDAD ALTA = LA FILA FRONTAL ENTERA, no solo la
                          destacada.

                          Al crecer las figuras, el LCP dejó de ser el título y
                          pasó a ser una imagen: las tres frontales se dibujan
                          a ~116 000 px² cada una, contra los ~49 000 px² de la
                          línea del título. Son tres candidatas de área casi
                          idéntica, así que el LCP lo fija la ÚLTIMA en llegar.
                          Medido: con prioridad alta solo en la destacada,
                          ponente-02 pintaba a 432 ms pero ponente-01 —96 px²
                          más grande y en prioridad `auto`— llegaba a 916 ms y
                          se quedaba con el LCP.

                          Las de fondo se quedan en `auto` a propósito: van a
                          escala 0.82, o sea un 67% del área, y no pueden ser
                          candidatas al LCP. `eager` en las seis porque todas
                          están sobre el pliegue.
                        */}
                        <img
                          class="figura__img"
                          src={asset(f.p.img)}
                          alt={`Retrato de ${f.p.nombre}`}
                          width={IMG_W}
                          height={IMG_H}
                          loading="eager"
                          fetchpriority={f.fila === 'frente' ? 'high' : 'auto'}
                          decoding="async"
                          data-fig-img
                        />
                        {/*
                          Si la imagen no carga, manda este marco punteado con
                          el nombre dentro. Nunca un icono de imagen rota.
                        */}
                        <div class="figura__placeholder">
                          <span>{f.p.nombre}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/*
                  La etiqueta es <figcaption>: está SIEMPRE en el árbol de
                  accesibilidad, aunque visualmente esté oculta en reposo. Un
                  lector de pantalla anuncia nombre y tema al llegar a la
                  figura sin depender del hover, que para él no existe.
                */}
                <figcaption class="figura__etiqueta">
                  <span class="figura__texto">
                    <span class="figura__nombre">{f.p.nombre}</span>
                    <span class="figura__tema">{f.p.tema}</span>
                  </span>
                  <span class="figura__guia" aria-hidden="true"></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import site from '../data/site.json';

  /*
    Nada de esto depende de GSAP. La cuenta regresiva y el reemplazo de las
    imágenes se resuelven primero y sin imports pesados: si el chunk de
    animaciones (~132 KB) no llega, el hero sigue siendo correcto.
  */
  const hero = document.querySelector<HTMLElement>('.hero');
  const raiz = document.documentElement;

  /* =======================================================================
     QUIÉN ES DUEÑO DE LA ENTRADA DEL HERO

     La entrada animada es mejora progresiva, no requisito: nadie debería
     esperar a un chunk de 48 KB para ver una imagen que su navegador ya
     descargó. Medido en 4G lento: la imagen que marca el LCP acababa de
     bajar a 1640 ms, pero el LCP se registraba a 2516 ms porque las figuras
     seguían en opacity 0 esperando a GSAP, que llegaba a 2423 ms.

     Hay un único dueño, decidido una sola vez:

       'gsap' — llegó a tiempo. Corre el escalonado del centro hacia afuera,
                exactamente igual que antes.
       'css'  — llegó tarde. El CSS revela cada figura en cuanto carga SU
                imagen, y GSAP, cuando aparezca, RENUNCIA a la entrada y solo
                engancha flotación y parallax desde donde esté cada figura.

     REGLA DE ORO: una figura ya visible no se re-anima jamás. Si GSAP
     reclamara la entrada después de que el CSS la haya corrido, las figuras
     saltarían 40px hacia abajo para volver a subir — peor que el retraso.
     De ahí que el dueño se decida una vez y no se pueda cambiar.

     EL PLAZO SE MIDE DESDE EL INICIO DE LA NAVEGACIÓN, no desde que corre
     este script, y no desde que carga la primera imagen. Con «la primera
     imagen» como disparador el CSS ganaría SIEMPRE: en red rápida las
     imágenes están listas a ~43 ms y este módulo corre a ~298 ms, así que
     `img.complete` ya es true al arrancar y el escalonado de GSAP no se
     vería nunca. Con 700 ms, GSAP —listo a ~300 ms en red rápida— gana con
     2.3x de margen, y en 4G —2400 ms— pierde, que es justo lo que se busca.
     ==================================================================== */
  const PLAZO_ENTRADA = 700;

  const revelar = (el: HTMLElement | null) => {
    if (el) el.dataset.revelada = '1';
  };

  const reclamarEntradaCss = () => {
    if (raiz.dataset.heroEntrada || !hero) return; // ya hay dueño
    raiz.dataset.heroEntrada = 'css';

    // El texto no espera a nada: está parseado desde el primer byte.
    hero
      .querySelectorAll<HTMLElement>('.hero__content [data-anim]')
      .forEach(revelar);

    // Las figuras que ya tengan su imagen; el resto, al cargar.
    hero
      .querySelectorAll<HTMLElement>('[data-fig-marco][data-state="loaded"]')
      .forEach((marco) => revelar(marco.closest<HTMLElement>('[data-fig-entrada]')));
  };

  const revelarFiguraSiTocaAlCss = (marco: HTMLElement) => {
    if (raiz.dataset.heroEntrada !== 'css') return;
    revelar(marco.closest<HTMLElement>('[data-fig-entrada]'));
  };

  setTimeout(
    reclamarEntradaCss,
    Math.max(0, PLAZO_ENTRADA - performance.now())
  );

  // -----------------------------------------------------------------------
  // Cuenta regresiva. Corre siempre, con o sin movimiento reducido.
  // -----------------------------------------------------------------------
  (() => {
    const objetivo = new Date(site.inicio).getTime();
    const campos = new Map<string, HTMLElement>();
    for (const clave of ['dias', 'horas', 'min', 'seg']) {
      const el = document.querySelector<HTMLElement>(`[data-cd="${clave}"]`);
      if (el) campos.set(clave, el);
    }
    if (!campos.size) return;

    const pinta = (clave: string, valor: number) => {
      const el = campos.get(clave);
      const texto = String(valor).padStart(2, '0');
      // Solo se escribe si cambió: evita trabajo de layout cada segundo.
      if (el && el.textContent !== texto) el.textContent = texto;
    };

    const tick = () => {
      // Fecha inválida en site.json: ceros en vez de "NaN" en pantalla.
      const restante = Number.isNaN(objetivo)
        ? 0
        : Math.max(0, objetivo - Date.now());
      const seg = Math.floor(restante / 1000);

      pinta('dias', Math.floor(seg / 86400));
      pinta('horas', Math.floor((seg % 86400) / 3600));
      pinta('min', Math.floor((seg % 3600) / 60));
      pinta('seg', seg % 60);

      return restante;
    };

    if (tick() === 0) return; // El evento ya pasó: ceros fijos, sin intervalo.
    const id = setInterval(() => {
      if (tick() === 0) clearInterval(id);
    }, 1000);
  })();

  // -----------------------------------------------------------------------
  // Figuras: nunca debe verse un icono de imagen rota.
  // Es POR FIGURA, no global: que falle una no debe apagar a las demás.
  // -----------------------------------------------------------------------
  (() => {
    for (const marco of document.querySelectorAll<HTMLElement>('[data-fig-marco]')) {
      const img = marco.querySelector<HTMLImageElement>('[data-fig-img]');
      if (!img) continue;

      const cargada = () => {
        marco.dataset.state = 'loaded';
        // Si la entrada es del CSS, esta figura aparece ya. Si es de GSAP,
        // no se toca: la revelará el escalonado.
        revelarFiguraSiTocaAlCss(marco);
      };
      const fallida = () => {
        marco.dataset.state = 'failed';
        // Aunque la imagen no llegue, la caja debe aparecer: dentro está el
        // marco punteado con el nombre, que es contenido, no un hueco.
        revelarFiguraSiTocaAlCss(marco);
      };

      if (img.complete) {
        /*
          Ya resuelta antes de que corriera este script, así que aparece SIN
          fundido: no hay nada que suavizar —el píxel ya estaba decodificado
          antes del primer pintado— y el fundido sí costaba caro. Medido: las
          seis imágenes acaban de bajar a los 43 ms, pero con la transición de
          480 ms el LCP se iba a 896 ms, porque desde que las figuras crecieron
          el elemento LCP ES una de ellas y Chrome no lo da por pintado hasta
          que el fundido termina.

          El fundido sigue vivo para el caso que lo justificaba: una imagen que
          llega tarde y entra sobre el marco punteado.
        */
        if (img.naturalWidth > 0) {
          marco.dataset.instantanea = '1';
          cargada();
        } else fallida();
      } else {
        img.addEventListener('load', cargada, { once: true });
        img.addEventListener('error', fallida, { once: true });
      }
    }
  })();

  // -----------------------------------------------------------------------
  // Movimiento: mejora progresiva. Nada corre con prefers-reduced-motion, ni
  // si el chunk de animaciones falla al cargar.
  // -----------------------------------------------------------------------
  import('../scripts/animations.js')
    .then(({ initMotion }) => {
      const { gsap, reduced } = initMotion();
      if (reduced || !gsap || !hero) return;

      const media = hero.querySelector<HTMLElement>('[data-hero-media]');
      const entradas = hero.querySelectorAll<HTMLElement>('.hero__content [data-anim]');

      /*
        Las figuras se ordenan por data-fig-orden (0 = la destacada), calculado
        en build. Así el stagger recorre el conjunto del centro hacia afuera
        sin que el JS tenga que medir distancias otra vez.
      */
      const figuras = [...hero.querySelectorAll<HTMLElement>('.figura')].sort(
        (a, b) => Number(a.dataset.figOrden ?? 0) - Number(b.dataset.figOrden ?? 0)
      );
      const cajasEntrada = figuras
        .map((f) => f.querySelector<HTMLElement>('[data-fig-entrada]'))
        .filter((el): el is HTMLElement => el !== null);

      /*
        Flotación permanente, una timeline INDEPENDIENTE por figura.

        Duración y desfase se derivan del índice de entrada, así que con seis
        figuras salen seis periodos distintos (5.4 → 9.65 s) y seis arranques
        distintos. Si subieran a la vez, el conjunto se leería como una sola
        imagen moviéndose.

        Las de FONDO flotan con menos amplitud: el paralaje de amplitud es lo
        que refuerza que están más lejos.

        Arranca SIEMPRE desde donde esté la figura —`gsap.to` lee el valor
        actual— así que sirve igual venga la entrada de GSAP o del CSS. No
        reposiciona nada.
      */
      const arrancarFlotacion = () => {
        figuras.forEach((figura, i) => {
          const flota = figura.querySelector<HTMLElement>('[data-fig-flota]');
          if (!flota) return;

          const esFondo = figura.closest('.pieza--fondo') !== null;
          const amplitud = esFondo ? 7 : 10;
          const duracion = 5.4 + i * 0.85;
          const desfase = i * 0.37;

          /*
            Tramo de entrada de 0 a −amplitud antes del ciclo: arrancar
            directamente en el extremo daría un salto seco.
          */
          gsap.to(flota, {
            y: -amplitud,
            duration: 1.5,
            delay: desfase,
            ease: 'sine.out',
            onComplete: () => {
              gsap.fromTo(
                flota,
                { y: -amplitud },
                {
                  y: amplitud,
                  duration: duracion / 2,
                  ease: 'sine.inOut',
                  yoyo: true,
                  repeat: -1,
                }
              );
            },
          });
        });
      };

      // Parallax: el conjunto se queda atrás respecto al texto al hacer scroll.
      const arrancarParallax = () => {
        if (!media) return;
        gsap.to(media, {
          yPercent: 12,
          ease: 'none',
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: 'bottom top',
            scrub: 0.5,
          },
        });
      };

      /*
        GSAP LLEGÓ TARDE: el CSS ya reveló el hero. Se RENUNCIA a la entrada.

        Ni un `fromTo`, ni un `from`, ni un `set`: cualquiera de los tres
        volvería a poner las figuras en opacity 0 con y=40 para animarlas otra
        vez, y el usuario vería la composición saltar hacia abajo y volver a
        subir. Solo se enganchan flotación y parallax, que parten del estado
        actual y no lo tocan.
      */
      if (raiz.dataset.heroEntrada === 'css') {
        arrancarFlotacion();
        arrancarParallax();
        return;
      }

      raiz.dataset.heroEntrada = 'gsap';

      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      // Eyebrow, cada línea del título, tagline, cuenta regresiva y botones.
      tl.fromTo(
        entradas,
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.8, stagger: 0.08 }
      );

      if (cajasEntrada.length) {
        /*
          LAS FIGURAS ABREN EL TIMELINE, no lo cierran.

          Desde que crecieron, el elemento LCP de la página ES una de las
          figuras frontales, así que el LCP mide cuándo acaba de aparecer la
          última. Con la entrada arrancando a 0.2 s, 1.1 s de duración y 0.12
          de escalonado, la sexta no estaba puesta hasta pasado un segundo y
          medio. Entrando en el arranque y algo más rápido, el LCP baja sin
          perder el escalonado del centro hacia afuera, que es lo que hace
          legible la composición.
        */
        tl.fromTo(
          cajasEntrada,
          { opacity: 0, y: 40, scale: 0.97 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.75,
            stagger: 0.09,
            onComplete: arrancarFlotacion,
          },
          0
        );
      } else {
        arrancarFlotacion();
      }

      arrancarParallax();
    })
    .catch(() => {
      /* Sin capa de movimiento: el hero ya está en su estado final. */
    });
</script>

<style>
  .hero {
    display: flex;
    min-height: 100svh;
    align-items: center;
    /*
      Ver más abajo: en pantallas BAJAS el min-height se rebaja. Un teléfono
      girado tiene ~430px de alto y exigir 100svh dejaba los CTAs en y=567,
      fuera de pantalla.
    */
    /* clip y no hidden: no crea contenedor de scroll y evita desbordes
       horizontales del halo, del parallax y del sangrado del conjunto. */
    overflow: clip;
    padding-block: calc(var(--nav-h) + var(--space-xl)) var(--space-2xl);
  }

  .hero__inner {
    display: grid;
    width: 100%;
    max-width: var(--container);
    align-items: center;
    /*
      2.5rem en TODO el rango, también en escritorio, donde antes eran 4rem.
      Estrechar el canal ensancha las DOS columnas a la vez: la de texto pasa
      de 524 a 537px —con más margen que antes para que «para el sector» no se
      parta al entrar la fuente display, que es lo que dispara el CLS— y la de
      figuras gana los mismos 13px. Por eso ya no hay override en el @media de
      62rem: sería una declaración idéntica a esta.
    */
    gap: var(--space-xl);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* =========================================================================
     ENTRADA RECLAMADA POR EL CSS

     Solo se activa cuando GSAP llegó tarde y el script puso
     data-hero-entrada="css" en <html>. Ver el porqué en el <script>.

     Con la entrada de GSAP estas reglas no existen, así que no hay dos
     sistemas peleándose por el mismo elemento — y, sobre todo, ningún
     `transition` vive en un elemento que GSAP esté animando fotograma a
     fotograma, que es la forma clásica de que una flotación salga a tirones.

     El desplazamiento es de 12px, no de los 40 de GSAP: el CSS entra cuando
     la red va mal, y ahí un gesto corto se lee mejor que uno largo.
     ====================================================================== */
  :global([data-motion='on'][data-hero-entrada='css']) .hero__content [data-anim],
  :global([data-motion='on'][data-hero-entrada='css']) .figura__entrada {
    transform: translateY(12px);
