  :global([data-motion='on'][data-hero-entrada='css'])
    .hero__content
    [data-anim][data-revelada],
  :global([data-motion='on'][data-hero-entrada='css'])
    .figura__entrada[data-revelada] {
    opacity: 1;
    transform: none;
  }

  /* Columna de texto ------------------------------------------------------- */

  /* min-width:0 anula el min-width:auto que traen los ítems de grid; sin esto
     la palabra más larga del título define el ancho de la pista y el reparto
     52/48 nunca llega a aplicarse. */
  .hero__content {
    min-width: 0;
  }

  .hero__eyebrow {
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /*
    Por debajo de 27rem el eyebrow se parte SIEMPRE en dos líneas, decidido
    por CSS y no por lo que mida la fuente. Es lo que elimina el reflow al
    entrar Inter Variable. Por encima cabe de sobra en una línea y vuelve a
    ser texto corrido con su separador.
  */
  @media (max-width: 27rem) {
    .hero__eyebrow-parte {
      display: block;
    }

    .hero__eyebrow-sep {
      display: none;
    }
  }

  .hero__title {
    margin-block-start: var(--space-md);
    /*
      Dos restricciones tiran en direcciones opuestas:
      - El mínimo baja a 2.5rem (no 2.6) para que "para el sector" quepa sin
        partirse en un viewport de 375px.
      - El máximo baja a 5rem (no 6) porque a 6rem la palabra "productividad"
        mide ~611px y NO cabe en el 52% de la columna: como los ítems de grid
        tienen min-width:auto, el título ensanchaba su pista y el reparto real
