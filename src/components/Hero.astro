  /* =========================================================================
     Columna de figuras
     ====================================================================== */
  .hero__media {
    position: relative;
  }

  .hero__halo {
    position: absolute;
    inset: 0;
    width: 80%;
    aspect-ratio: 1;
    margin: auto;
    border-radius: 50%;
    /* Sutil a propósito: solo evita que los recortes floten sobre un plano
       vacío. Se conserva tal cual desde la Fase 2. */
    background: radial-gradient(circle, var(--primary) 0%, transparent 68%);
    opacity: 0.3;
    filter: blur(56px);
    pointer-events: none;
  }

  /* === BASE (móvil): rejilla de retratos ================================= */
  .conjunto {
    /*
      Flex con wrap y no grid a propósito: con un número impar de figuras el
      sobrante queda CENTRADO en su fila en vez de alineado a la izquierda con
      un hueco huérfano al lado. Con 6 y 3 columnas salen dos filas llenas;
      con 3 y 2 columnas, 2+1 centrado.
    */
    --cols: 2;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pieza {
    /* El ancho sale del número de COLUMNAS, no del de figuras: la rejilla se
       ve igual de ordenada con 3 que con 6. */
    inline-size: calc((100% - (var(--cols) - 1) * var(--space-md)) / var(--cols));
  }

  .figura {
    position: relative;
    margin: 0;
    /* El anillo de foco lo dibuja :focus-visible global; el radio hace que
       siga la silueta del marco y no un rectángulo suelto. */
    border-radius: var(--radius-media);
  }

  /* En la rejilla no hay solapes, así que la zona sensible es la figura
     entera. En la composición se reduce a su banda (ver más abajo). */
  .figura__zona {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .figura__marco {
    position: relative;
    aspect-ratio: 672 / 900;
  }

  .figura__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /*
      Desvanecido inferior: las figuras están recortadas al borde inferior del
      lienzo y ese corte recto, flotando sobre el halo, se lee como un tajo.

      Va en el <img> y NO en .figura__marco a propósito: así el placeholder
      punteado (hermano, no hijo) se queda intacto cuando la imagen no carga.

      `black` y `transparent` NO son colores de diseño: de una máscara el
      navegador solo lee el canal alfa, así que esto significa «opaco →
      transparente», no «negro».
    */
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 88%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 88%,
      transparent 100%
    );
  }

  .figura__placeholder {
    position: absolute;
    inset: 0;
    display: none;
    align-content: center;
    padding: var(--space-xs);
    border: 1px dashed var(--border);
    border-radius: var(--radius-media);
    color: var(--text-muted);
    font-size: var(--step--1);
    text-align: center;
    text-wrap: balance;
  }

  /*
    Reparto de responsabilidades entre CSS y JS:
    - Sin JS ([data-js] ausente): se ve la imagen, nunca el placeholder.
    - Con JS: manda el placeholder y la imagen espera invisible; solo aparece
      al confirmarse la carga. Así jamás se ve el icono de imagen rota.
  */
  :global([data-js]) .figura__placeholder {
