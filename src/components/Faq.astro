---
import faq from '../data/faq.json';
import { conConteo } from '../scripts/programa.js';

/*
  Preguntas frecuentes.

  Acordeón con <details>/<summary> NATIVOS, no divs con JavaScript. Motivos:
  abre y cierra sin bundle, el teclado ya funciona de serie (Enter y Espacio),
  los lectores de pantalla anuncian el estado expandido/plegado solos, y el
  buscador del navegador (Ctrl+F) encuentra texto dentro de un <details>
  cerrado en los navegadores modernos. Nada de esto habría salido gratis
  reimplementándolo.
*/
---

<section class="faq" id="faq" {...Astro.props}>
  <div class="faq__inner">
    <header class="faq__head">
      <p class="faq__eyebrow" data-anim>Preguntas frecuentes</p>
      <h2 class="faq__titulo" data-anim>Lo que suelen preguntarnos</h2>
    </header>

    <div class="faq__lista">
      {faq.map((item) => (
        <details class="item" data-anim>
          <summary class="item__pregunta">
            <span class="item__texto">{item.pregunta}</span>
            <svg
              class="item__chevron"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                d="m6 9.5 6 6 6-6"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </summary>
          <div class="item__respuesta">
            {/* conConteo: la respuesta del boleto lleva {conferenciasPalabra},
                que sale de contar las ponencias de programa.json. */}
            <p>{conConteo(item.respuesta)}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('.faq');

  import('../scripts/animations.js')
    .then(({ initMotion }) => {
      const { gsap, reduced } = initMotion();
      if (reduced || !gsap || !seccion) return;

      gsap.fromTo(
        seccion.querySelectorAll<HTMLElement>('[data-anim]'),
        { opacity: 0, y: 20 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          stagger: 0.07,
          ease: 'power3.out',
          scrollTrigger: { trigger: seccion, start: 'top 80%', once: true },
        }
      );
    })
    .catch(() => {
      /* Sin capa de movimiento: la sección ya está en su estado final. */
    });
</script>

<style>
  .faq {
    padding-block: var(--space-3xl);
  }

  .faq__inner {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .faq__head {
    text-align: center;
  }

  .faq__eyebrow {
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .faq__titulo {
    margin-block-start: var(--space-sm);
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .faq__lista {
    margin-block-start: var(--space-2xl);
  }

  /* Acordeón --------------------------------------------------------------- */
  .item {
    border-block-end: 1px solid var(--border);
  }

  .item:first-child {
    border-block-start: 1px solid var(--border);
  }

  .item__pregunta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-md);
    align-items: center;
    padding-block: var(--space-lg);
    cursor: pointer;
    /* Quita el triángulo nativo en todos los motores; el chevron es nuestro. */
    list-style: none;
    transition: color var(--t-base) var(--ease-out);
  }

  .item__pregunta::-webkit-details-marker {
    display: none;
  }

  .item__pregunta:hover {
    color: var(--accent);
  }

  /* El foco va en el <summary>, que es lo que recibe el teclado. El offset
     negativo evita que el anillo se salga del contenedor en móvil. */
  .item__pregunta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .item__texto {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .item__chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition:
      rotate var(--t-base) var(--ease-out),
      color var(--t-base) var(--ease-out);
  }

  .item[open] .item__chevron {
    rotate: 180deg;
    color: var(--accent);
  }

  .item__respuesta {
    padding-block-end: var(--space-lg);
    padding-inline-end: var(--space-2xl);
    color: var(--text-muted);
  }

  /*
    La animación de apertura va SOLO en el chevron.

    Animar la altura de un <details> obliga a medir el contenido con JS y a
    tomar el control del abierto/cerrado, que es exactamente lo que hace que
    estos acordeones dejen de funcionar sin bundle. El contenido aparece de
    golpe, como en el elemento nativo, y a cambio el componente no depende de
    JavaScript para nada.
  */
</style>
